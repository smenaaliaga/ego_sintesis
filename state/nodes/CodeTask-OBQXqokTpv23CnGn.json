  "code_lines": [
    "﻿/******************BASE CON VARIABLES DE LAS CNT A UTILIZAR PARA AJUSTAR DATOS DE LAS CNSI********************/\r",
    "ods graphics / imagemap;\r",
    "\r",
    "PROC SQL;/*PIB ACUMULADO ANUAL*/\r",
    "   CREATE TABLE PIB AS \r",
    "   SELECT t2.'AÑO_ACUM'n AS AÑO, \r",
    "          t2.TRIM_ACUM AS TRIM, \r",
    "          (SUM(t1.DATO))/1000 AS DATO\r",
    "      FROM TABLAS.PIB t1, TABLAS.TIEMPO t2\r",
    "      WHERE (t1.'AÑO'n = t2.'AÑO'n AND t1.TRIM = t2.TRIM)\r",
    "      GROUP BY t2.'AÑO_ACUM'n,\r",
    "               t2.TRIM_ACUM;\r",
    "QUIT;\r",
    "proc sql; delete from PIB where año=&ANIO and trim>&TRIM;quit;\r",
    "\r",
    "/*CREA RATIO DE AJCON A PIB-TRIMESTRAL*/\r",
    "PROC SQL;\r",
    "CREATE TABLE WORK.AF71 AS\r",
    "SELECT T1.AÑO,T1.TRIM,(substr(PUT(t1.'AÑO'n,CHAR4.),3,2) ||\".\"|| PUT(t1.TRIM,CHAR1.))  AS PERIODO,\r",
    "\tT1.C_ENTRADA,T2.C_SI_SCN_N1,T2.N_SI_SCN_N1, \r",
    "\tSUM(T1.DATO)/1000 FORMAT COMMA14.3 AS DATO, \r",
    "   (SUM(T1.DATO)/1000)/T3.DATO FORMAT PERCENT.2 AS RATIO\r",
    "FROM TABLAS.BD_CTSI T1 \r",
    "LEFT JOIN TABLAS.T_Sectorizacion T2 ON (T1.SECTOR=T2.C_SI) \r",
    "LEFT JOIN TABLAS.T_Instrumentos T4 ON (T1.C_SCN=T4.C_SCN) \r",
    "LEFT JOIN WORK.PIB T3 ON (T1.AÑO=T3.AÑO AND T1.TRIM=T3.TRIM) \r",
    "where T1.C_Cuenta=('Financiera')  AND T1.AÑO>2002 AND T1.C_SCN IN('AF.71','AF.9') AND T1.C_ENTRADA='D' AND T3.DATO<>.\r",
    "GROUP BY T1.AÑO,T1.TRIM,T1.C_ENTRADA,T2.C_SI_SCN_N1,T2.N_SI_SCN_N1,T3.DATO;\r",
    "QUIT;\r",
    "/*GRAFICOS AJUSTE CONCILIACIÓN TRIMESTRAL*/\r",
    "PROC SORT\r",
    "\tDATA=WORK.AF71(KEEP=PERIODO RATIO N_SI_SCN_N1)\r",
    "\tOUT=WORK.SORTTempTableSorted;\r",
    "\tBY N_SI_SCN_N1;\r",
    "RUN;\r",
    "Legend2 FRAME;\r",
    "Legend1 FRAME;\r",
    "Axis1\r",
    "\tSTYLE=1\r",
    "\tWIDTH=1\r",
    "\tMINOR=NONE\r",
    "\tLABEL=NONE;\r",
    "Axis2\r",
    "\tSTYLE=1\r",
    "\tWIDTH=1 \tMINOR=NONE\r",
    "\tLABEL=NONE;\r",
    "TITLE \"Trimestral\";\r",
    "TITLE1 \"Trimestral - Sector: #BYVAL(N_SI_SCN_N1)\";\r",
    "TITLE2;TITLE3;\r",
    "FOOTNOTE;\r",
    "OPTIONS NOBYLINE;\r",
    "\r",
    "PROC GCHART DATA=WORK.SORTTempTableSorted\r",
    ";\r",
    "\tVBAR PERIODO/\tSUMVAR=RATIO\r",
    "\tCLIPREF\r",
    "FRAME\tTYPE=SUM\r",
    "\tCOUTLINE=SAME\r",
    "\tRAXIS=AXIS1\r",
    "\tMAXIS=AXIS2\r",
    "\tLREF=1\r",
    "\tCREF=BLACK\r",
    "\tAUTOREF\r",
    "\tREF=0.005 -0.005\r",
    ";/*\tLABEL N_SI_SCN_N1='Sector: ';*/\r",
    "\tBY N_SI_SCN_N1;\r",
    "RUN; QUIT;\r",
    "%_eg_conditional_dropds(WORK.SORTTempTableSorted);\r",
    "TITLE; FOOTNOTE;\r",
    "/*GRAFICOS AJUSTE CONCILIACIÓN TRIMESTRAL EMPRESAS+HOGARES*/\r",
    "PROC SORT\r",
    "\tDATA=WORK.AF71(KEEP=PERIODO RATIO C_SI_SCN_N1 WHERE=(C_SI_SCN_N1 IN('S.14','S.11')))\r",
    "\tOUT=WORK.AF71_EH;\r",
    "BY C_SI_SCN_N1;\r",
    "RUN;\r",
    "Legend2 FRAME;\r",
    "Legend1 FRAME;\r",
    "Axis1\r",
    "\tSTYLE=1\r",
    "\tWIDTH=1\r",
    "\tMINOR=NONE\r",
    "\tLABEL=NONE;\r",
    "Axis2\r",
    "\tSTYLE=1\r",
    "\tWIDTH=1 \tMINOR=NONE\r",
    "\tLABEL=NONE;\r",
    "TITLE;\r",
    "TITLE1 \"Sector= Empresas y Hogares\";\r",
    "TITLE2;\r",
    "FOOTNOTE;\r",
    "PROC GCHART DATA=WORK.AF71_EH;\r",
    "\tVBAR PERIODO/SUMVAR=RATIO\r",
    "\tCLIPREF\r",
    "\tFRAME\tTYPE=SUM\r",
    "\tCOUTLINE=SAME\r",
    "\tRAXIS=AXIS1\r",
    "\tMAXIS=AXIS2\r",
    "\tLREF=1\r",
    "\tCREF=BLACK\r",
    "\tAUTOREF\r",
    "\tREF=0.005 -0.005;\t/*LABEL N_SI_SCN_N1=\"Sector\"*/;\r",
    "\t/*BY N_SI_SCN_N1;*/\r",
    "RUN; QUIT;\r",
    "%_eg_conditional_dropds(WORK.SORTTempTableSorted);\r",
    "TITLE; FOOTNOTE;\r",
    "\r",
    ""
  ]
}
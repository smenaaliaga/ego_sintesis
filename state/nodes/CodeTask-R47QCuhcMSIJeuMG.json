  "code_lines": [
    "﻿/*GENERA DATOS B9*/\r",
    "\r",
    "PROC SQL;\r",
    "CREATE TABLE WORK.B9 AS\r",
    "SELECT T1.AÑO,T1.TRIM,\tT1.TRIM,(substr(PUT(t1.'AÑO'n,CHAR4.),3,2) ||\".\"|| PUT(t1.TRIM,CHAR1.)) AS PERIODO,\r",
    "T5.C_Cuenta_SCN, T5.N_Cuenta_SCN, T1.SECTOR,T4.C_SCN_N1,T4.N_SCN_N1,T1.C_ENTRADA,T2.C_SI_SCN_N1, T2.N_SI_SCN_N1, (T1.DATO) AS DATO \r",
    "FROM TABLAS.BD_CTSI T1 \r",
    "LEFT JOIN TABLAS.T_Sectorizacion T2 ON (T1.SECTOR=T2.C_SI) \r",
    "LEFT JOIN TABLAS.T_Instrumentos T4 ON (T1.C_SCN=T4.C_SCN) \r",
    "LEFT JOIN TABLAS.T_Cuenta T5 ON (T1.C_CUENTA=T5.C_CUENTA)\r",
    "where /*T5.N_Cuenta_SCN IN ('Cuenta de capital','Cuenta Financiera') AND*/ T4.C_SCN_N1=('B.9') AND T1.AÑO>2002 AND T2.C_SI_SCN_N1='S.12'\r",
    "/*GROUP BY T1.AÑO,T1.TRIM,T5.C_Cuenta_SCN, T5.N_Cuenta_SCN, T4.C_SCN_N1,T4.N_SCN_N1,T1.C_ENTRADA,T2.C_SI_SCN_N1, T2.N_SI_SCN_N1*/;\r",
    "QUIT;\r",
    "\r",
    "\r",
    "PROC SQL;\r",
    "CREATE TABLE WORK.B9 AS\r",
    "SELECT T1.AÑO,T1.TRIM,\tT1.TRIM,(substr(PUT(t1.'AÑO'n,CHAR4.),3,2) ||\".\"|| PUT(t1.TRIM,CHAR1.)) AS PERIODO,\r",
    "T5.C_Cuenta_SCN, T5.N_Cuenta_SCN, T4.C_SCN_N1,T4.N_SCN_N1,T1.C_ENTRADA,T2.C_SI_SCN_N1, T2.N_SI_SCN_N1, SUM(T1.DATO)/1000 AS DATO \r",
    "FROM TABLAS.BD_CTSI T1 \r",
    "LEFT JOIN TABLAS.T_Sectorizacion T2 ON (T1.SECTOR=T2.C_SI) \r",
    "LEFT JOIN TABLAS.T_Instrumentos T4 ON (T1.C_SCN=T4.C_SCN) \r",
    "LEFT JOIN TABLAS.T_Cuenta T5 ON (T1.C_CUENTA=T5.C_CUENTA)\r",
    "where /*T5.N_Cuenta_SCN IN ('Cuenta de capital','Cuenta Financiera') AND*/ T4.C_SCN_N1=('B.9') AND T1.AÑO>2002\r",
    "GROUP BY T1.AÑO,T1.TRIM,T5.C_Cuenta_SCN, T5.N_Cuenta_SCN, T4.C_SCN_N1,T4.N_SCN_N1,T1.C_ENTRADA,T2.C_SI_SCN_N1, T2.N_SI_SCN_N1;\r",
    "QUIT;\r",
    "/*TABLA*/\r",
    "TITLE;\r",
    "TITLE1 \"CONSISTENCIA CAPACIDAD/NECESIDAD DE FINANCIAMIENTO\";\r",
    "TItLE2\t\t\"(Miles de millones de pesos)\";\r",
    "FOOTNOTE;\r",
    "PROC TABULATE\r",
    "DATA=WORK.B9;\r",
    "\tVAR DATO;\r",
    "\tCLASS N_Cuenta_SCN /\tORDER=FORMATTED MISSING;\r",
    "\tCLASS C_SI_SCN_N1 /\tORDER=FORMATTED MISSING;\r",
    "\tCLASS N_SI_SCN_N1 /\tORDER=UNFORMATTED MISSING;\r",
    "\tCLASS \"AÑO\"n /\tORDER=UNFORMATTED MISSING;\r",
    "\tCLASS TRIM /\tORDER=UNFORMATTED MISSING;\r",
    "\tTABLE \r",
    "\t\t/* ROW Statement */\r",
    "\t\tAÑO*TRIM,\r",
    "\t\t/* COLUMN Statement */\r",
    "\t\tC_SI_SCN_N1={LABEL=\"\"}*N_SI_SCN_N1={LABEL=\"\"}*N_Cuenta_SCN={LABEL=\"\"}*(DATO={LABEL=\"\"}*F=COMMA14.* Sum={LABEL=\"\"}*F=COMMA14.);\r",
    "\t;RUN;RUN; QUIT;\r",
    "TITLE; FOOTNOTE;\r",
    "\r",
    "/*DIFERENCIA ENTRE B9 CNF VS CF*/\r",
    "PROC SQL;\r",
    "CREATE TABLE B9_DIF AS\r",
    "SELECT T1.AÑO,T1.TRIM,T1.PERIODO,T1.C_SCN_N1,T1.C_SI_SCN_N1, T1.N_SI_SCN_N1, SUM(CASE WHEN T1.C_ENTRADA='D' THEN T1.DATO*-1 ELSE T1.DATO END)*1000 AS DATO \r",
    "FROM B9 T1 \r",
    "GROUP BY T1.AÑO,T1.TRIM,T1.C_SCN_N1,T1.C_SI_SCN_N1, T1.N_SI_SCN_N1;\r",
    "QUIT;\r",
    "/*TABLA DIF PTMO NETO*/\r",
    "TITLE;\r",
    "TITLE1 \"CONSISTENCIA CAPACIDAD/NECESIDAD DE FINANCIAMIENTO CTA CAPITAL VS CTA FINANCIERA POR SECTOR\";\r",
    "TItLE2\t\t\"(Millones de pesos)\";\r",
    "FOOTNOTE \"(*) muestra solo periodos con diferencias\";\r",
    "\r",
    "\r",
    "PROC TABULATE\r",
    "DATA=B9_DIF;\r",
    " WHERE (DATO>0.03 OR DATO<-0.03);\r",
    "\tVAR DATO;\r",
    "\tCLASS C_SI_SCN_N1 /\tORDER=FORMATTED MISSING;\r",
    "\tCLASS N_SI_SCN_N1 /\tORDER=UNFORMATTED MISSING;\r",
    "\tCLASS \"AÑO\"n /\tORDER=UNFORMATTED MISSING;\r",
    "\tCLASS TRIM /\tORDER=UNFORMATTED MISSING;\r",
    "\tTABLE \r",
    "\t\t/* ROW Statement */\r",
    "\t\tAÑO*TRIM,\r",
    "\t\t/* COLUMN Statement */\r",
    "\t\tC_SI_SCN_N1={LABEL=\"\"}*N_SI_SCN_N1={LABEL=\"\"}*(DATO={LABEL=\"\"}*F=COMMA14.3* Sum={LABEL=\"\"}*F=COMMA14.3);\r",
    "\t;RUN;RUN; QUIT;\r",
    "TITLE; FOOTNOTE;\r",
    "\r",
    "/*GRAFICOS B9*/\r",
    "ods graphics / imagemap;\r",
    "\r",
    "PROC SORT\r",
    "\tDATA=WORK.B9(KEEP=PERIODO DATO N_SI_SCN_N1 N_Cuenta_SCN)  \r",
    "\tOUT=WORK.SORTTempTableSorted;\r",
    "\tBY N_SI_SCN_N1 N_Cuenta_SCN PERIODO;\r",
    "RUN;\r",
    "SYMBOL1\r",
    "\tINTERPOL=JOIN\r",
    "\tHEIGHT=10pt\r",
    "\tVALUE=NONE\r",
    "\tLINE=1\r",
    "\tWIDTH=3\r",
    "\tCI=RED\r",
    "\tCV = _STYLE_;\r",
    "SYMBOL2\r",
    "\tINTERPOL=JOIN\r",
    "\tHEIGHT=10pt\r",
    "\tFONT=MARKER\r",
    "\tVALUE=NONE\r",
    "\tLINE=3\r",
    "\tWIDTH=3\r",
    "\tCI=CX000080\r",
    "\tCV = _STYLE_;\r",
    "Legend1\r",
    "\tFRAME\r",
    "\tCBORDER=WHITE\r",
    "\tPOSITION = (TOP CENTER INSIDE)\r",
    "\tLABEL=(FONT='Calibri' COLOR=WHITE )\r",
    "\tMODE=PROTECT;\r",
    "Axis1\r",
    "\tSTYLE=1\r",
    "\tWIDTH=1\r",
    "\tMINOR=NONE\r",
    "\tLABEL=NONE;\r",
    "Axis2\r",
    "\tSTYLE=1\r",
    "\tWIDTH=1\r",
    "\tMINOR=NONE\r",
    "\tLABEL=NONE\r",
    "OFFSET=(2,2);\r",
    "TITLE;\r",
    "TITLE1 \"CONSISTENCIA CAPACIDAD/NECESIDAD DE FINANCIAMIENTO\";\r",
    "TITLE2 \"(miles de millones de pesos)\";\r",
    "TITLE3 \"Sector: #BYVAL(N_SI_SCN_N1)\";\r",
    "\r",
    "FOOTNOTE;\r",
    "OPTIONS NOBYLINE;\r",
    "\r",
    "PROC GPLOT DATA = WORK.SORTTempTableSorted\r",
    " NOCACHE;\r",
    "PLOT DATO * PERIODO=N_Cuenta_SCN/VAXIS=AXIS1 HAXIS=AXIS2 \r",
    "FRAME\tLEGEND=LEGEND1;\r",
    "/*\tLABEL\r",
    "\t\tN_SI_SCN_N1=\"Sector\";*/\r",
    "\tBY  N_SI_SCN_N1;\r",
    "RUN; QUIT;\r",
    "%_eg_conditional_dropds(WORK.SORTTempTableSorted);\r",
    "GOPTIONS RESET = SYMBOL;\r",
    "\r",
    "\r",
    "/*GENERA DATOS B9 PARA COMPARATIVO HOGARES*/\r",
    "PROC SQL;/*PERIODOS CNSI*/\r",
    "CREATE TABLE WORK.PERIODOS AS\r",
    "SELECT T1.AÑO,T1.TRIM, COUNT(T1.DATO) AS COUNT \r",
    "FROM TABLAS.BD_CTSI T1 /*WHERE COUNT(T1.DATO)<6000*/\r",
    "GROUP BY T1.AÑO,T1.TRIM;\r",
    "QUIT;\r",
    "PROC SQL; DELETE FROM WORK.PERIODOS WHERE COUNT<6000; QUIT;\r",
    "PROC SQL;/*PTMO NETO CNF*/\r",
    "CREATE TABLE WORK.B9_HH_1 AS\r",
    "SELECT t3.'AÑO_ACUM'n, t3.TRIM_ACUM,(substr(PUT(t1.'AÑO'n,CHAR4.),3,2) ||\".\"|| PUT(t1.TRIM,CHAR1.)) AS PERIODO,\r",
    "'B9' AS ID, T2.N_SI_SCN_N1, SUM(T1.DATO)/1000 AS DATO \r",
    "FROM TABLAS.BD_CTSI T1,WORK.PERIODOS T6,TABLAS.T_Sectorizacion T2, TABLAS.T_Instrumentos T4,TABLAS.T_Cuenta T5,TABLAS.Tiempo T3\r",
    "where T5.C_Cuenta_SCN='F' AND T4.C_SCN_N1=('B.9') AND T1.AÑO>2002 AND T2.C_SI_SCN_N1='S.14' \r",
    "\t  AND T1.SECTOR=T2.C_SI AND T1.C_SCN=T4.C_SCN AND T1.C_CUENTA=T5.C_CUENTA AND t1.'AÑO'n = t3.'AÑO'n AND t1.TRIM = t3.TRIM\r",
    "\t  AND t3.'AÑO_ACUM'n = t6.'AÑO'n AND t3.TRIM_ACUM = t6.TRIM\r",
    "GROUP BY t3.'AÑO_ACUM'n,t3.TRIM_ACUM,CALCULATED PERIODO,CALCULATED ID, T2.N_SI_SCN_N1;\r",
    "QUIT;\r",
    "PROC SQL;/*PTMO NETO SIN AF3,AF5, AF71 EN ACTIVO*/\r",
    "CREATE TABLE WORK.B9_HH_2 AS\r",
    "SELECT t3.'AÑO_ACUM'n, t3.TRIM_ACUM,(substr(PUT(t1.'AÑO'n,CHAR4.),3,2) ||\".\"|| PUT(t1.TRIM,CHAR1.)) AS PERIODO,\r",
    "'B9*' AS ID, T2.N_SI_SCN_N1, \r",
    "SUM(CASE WHEN T1.C_ENTRADA='H' THEN T1.DATO*-1 ELSE T1.DATO END)/1000 AS DATO \r",
    "FROM TABLAS.BD_CTSI T1,WORK.PERIODOS T6,TABLAS.T_Sectorizacion T2, TABLAS.T_Instrumentos T4,TABLAS.T_Cuenta T5,TABLAS.Tiempo T3\r",
    "where T5.C_Cuenta_SCN='F' AND T1.AÑO>2002 AND T2.C_SI_SCN_N1='S.14' \r",
    "\t  AND T1.SECTOR=T2.C_SI AND T1.C_SCN=T4.C_SCN AND T1.C_CUENTA=T5.C_CUENTA AND t1.'AÑO'n = t3.'AÑO'n AND t1.TRIM = t3.TRIM\r",
    "\t  AND t3.'AÑO_ACUM'n = t6.'AÑO'n AND t3.TRIM_ACUM = t6.TRIM AND T1.C_SCN NOT IN ('AF.31','AF.32','AF.5','AF.71','B.9')\r",
    "GROUP BY t3.'AÑO_ACUM'n,t3.TRIM_ACUM,CALCULATED PERIODO,CALCULATED ID, T2.N_SI_SCN_N1;\r",
    "QUIT;\r",
    "PROC SQL;/*PTMO NETO SIN AF71 EN ACTIVO*/\r",
    "CREATE TABLE WORK.B9_HH_3 AS\r",
    "SELECT t3.'AÑO_ACUM'n, t3.TRIM_ACUM,(substr(PUT(t1.'AÑO'n,CHAR4.),3,2) ||\".\"|| PUT(t1.TRIM,CHAR1.)) AS PERIODO,\r",
    "'B9**' AS ID, T2.N_SI_SCN_N1, \r",
    "SUM(CASE WHEN T1.C_ENTRADA='H' THEN T1.DATO*-1 ELSE T1.DATO END)/1000 AS DATO \r",
    "FROM TABLAS.BD_CTSI T1,WORK.PERIODOS T6,TABLAS.T_Sectorizacion T2, TABLAS.T_Instrumentos T4,TABLAS.T_Cuenta T5,TABLAS.Tiempo T3\r",
    "where T5.C_Cuenta_SCN='F' AND T1.AÑO>2002 AND T2.C_SI_SCN_N1='S.14' \r",
    "\t  AND T1.SECTOR=T2.C_SI AND T1.C_SCN=T4.C_SCN AND T1.C_CUENTA=T5.C_CUENTA AND t1.'AÑO'n = t3.'AÑO'n AND t1.TRIM = t3.TRIM\r",
    "\t  AND t3.'AÑO_ACUM'n = t6.'AÑO'n AND t3.TRIM_ACUM = t6.TRIM AND T1.C_SCN NOT IN ('AF.71','B.9')\r",
    "GROUP BY t3.'AÑO_ACUM'n,t3.TRIM_ACUM,CALCULATED PERIODO,CALCULATED ID, T2.N_SI_SCN_N1;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "CREATE TABLE  WORK.B9_HH AS\r",
    "SELECT * FROM  WORK.B9_HH_1 OUTER UNION CORR SELECT * FROM WORK.B9_HH_2 OUTER UNION CORR SELECT * FROM WORK.B9_HH_3;\r",
    "RUN;\r",
    "/*GRAFICOS B9* COMPARATIVO HOGARES*/\r",
    "PROC SORT\r",
    "\tDATA=WORK.B9_HH (KEEP=PERIODO DATO N_SI_SCN_N1 ID)  \r",
    "\tOUT=WORK.SORTTempTableSorted;\r",
    "\tBY N_SI_SCN_N1 ID PERIODO;\r",
    "RUN;\r",
    "SYMBOL1\r",
    "\tINTERPOL=JOIN HEIGHT=10pt VALUE=NONE LINE=1 WIDTH=4 CI=GREEN CV = _STYLE_;\r",
    "SYMBOL2\r",
    "\tINTERPOL=JOIN HEIGHT=10pt FONT=MARKER VALUE=NONE LINE=1 WIDTH=3 CI=BLUE CV = _STYLE_;\r",
    "SYMBOL3\r",
    "\tINTERPOL=JOIN HEIGHT=10pt FONT=MARKER VALUE=NONE LINE=20 WIDTH=3 CI=RED CV = _STYLE_;\r",
    "Legend1\r",
    "\tFRAME\r",
    "\tCBORDER=WHITE\r",
    "\tPOSITION = (TOP CENTER INSIDE)\r",
    "\tLABEL=(FONT='Calibri' COLOR=WHITE )\r",
    "\tMODE=PROTECT;\r",
    "Axis1\r",
    "\tSTYLE=1\r",
    "\tWIDTH=1\r",
    "\tMINOR=NONE\r",
    "\tLABEL=NONE;\r",
    "Axis2\r",
    "\tSTYLE=1\r",
    "\tWIDTH=1\r",
    "\tMINOR=NONE\r",
    "\tLABEL=NONE;\r",
    "TITLE;\r",
    "TITLE1 \"CAPACIDAD/NECESIDAD DE FINANCIAMIENTO SECTOR HOGARES(*)\";\r",
    "TITLE2 \"(miles de millones de pesos, acumulado anual)\";\r",
    "FOOTNOTE \"(*)B9=original; B9*=excluye títulos, acciones y ajuste de conciliación; B9**=excluye ajuste de conciliación \";\r",
    "PROC GPLOT DATA = WORK.SORTTempTableSorted\r",
    " NOCACHE;\r",
    "PLOT DATO * PERIODO=ID/VAXIS=AXIS1 HAXIS=AXIS2\r",
    "FRAME\tLEGEND=LEGEND1;\r",
    "RUN; QUIT;\r",
    "%_eg_conditional_dropds(WORK.SORTTempTableSorted);\r",
    "GOPTIONS RESET = SYMBOL;\r",
    "\r",
    "PROC SQL;\r",
    "DROP TABLE WORK.B9,WORK.B9_HH,WORK.B9_HH_1,WORK.B9_HH_2,WORK.B9_HH_3,WORK.PERIODOS,B9_DIF;"
  ]
}
  "code_lines": [
    "﻿/*SALDOS DE INSTRUMENTOS FINANCIEROS POR SECTOR-INSTRUMENTO-CONTRAGENTE*/",
    "PROC SQL;",
    "CREATE TABLE Saldos_SI AS",
    "SELECT T1.AÑO,T1.TRIM,(PUT(t1.'AÑO'n,CHAR4.) ||\".\"|| PUT(t1.TRIM,CHAR1.)) AS PERIODO,T1.C_Cuenta,",
    "\t\t(case when T2.C_SI_SCN in ('S.123','S.124') then 'S.123+4' else T2.C_SI_SCN end) as C_Sector_pub,",
    "\t\tT2.N_SI_SCN as N_Sector_pub,",
    "\tT4.C_SCN_N1,T4.N_SCN_N1,",
    "\t(CASE WHEN T1.C_SCN='AF.21' THEN T4.N_SCN",
    "\t\tWHEN T1.C_SCN IN ('AF.22','AF.29') THEN 'Depósitos y otros depósitos'",
    "\t\t\tWHEN T1.C_SCN IN ('AF.31','AF.32','AF.321') THEN 'Títulos' ",
    "\t\t\t\tWHEN T1.C_SCN IN ('AF.34') THEN 'Derivados' ",
    "\t\t\t\t \tWHEN T1.C_SCN IN ('AF.521') THEN 'Cuotas MM' ",
    "\t\t\t\t\t\tWHEN T1.C_SCN IN ('AF.522') THEN 'Cuotas NM' ",
    "\t\t\t\telse T4.N_SCN_N0 end) as N_SCN_wtw,",
    "\tT4.C_SCN_N0,T4.N_SCN_N0,T3.C_SI_SCN AS C_SI_C_AGENTE,",
    "\t(case when T3.C_SI_SCN in ('S.123','S.124') then 'OFIs+Auxiliares' else t3.N_SI_SCN end) AS N_SI_C_AGENTE,",
    "\tT1.C_ENTRADA,",
    "\tSUM(T1.DATO)/1000 FORMAT COMMA14. AS DATO",
    "FROM TABLAS.BD_CTSI T1 ",
    "LEFT JOIN TABLAS.T_Sectorizacion T2 ON (T1.SECTOR=T2.C_SI) ",
    "LEFT JOIN TABLAS.T_Instrumentos T4 ON (T1.C_SCN=T4.C_SCN) ",
    "LEFT JOIN TABLAS.T_Contrapartidas T3 ON (T1.C_CAGENTE=T3.C_CAGENTE) ",
    "where T1.C_Cuenta in ('Bce Final','Financiera')  AND T1.AÑO>=&ANIO AND T1.C_SCN NOT IN ('B.90','B.9')  ",
    "GROUP BY T1.AÑO,T1.TRIM,T4.C_SCN_N1,T4.N_SCN_N1,T3.C_SI_SCN,calculated N_SI_C_AGENTE,T4.C_SCN_N0,T4.N_SCN_N0,T1.C_ENTRADA,calculated C_Sector_pub,T2.N_SI_SCN, calculated N_SCN_wtw,T1.C_Cuenta;",
    "QUIT;",
    "proc sql; update Saldos_SI set N_SI_C_AGENTE='Sociedades no financieras' where C_SI_C_AGENTE='S.99';quit;",
    "proc sql; update Saldos_SI set N_SI_C_AGENTE='Fondos de mutuos del mercado moneta' where C_SI_C_AGENTE='S.129';quit;",
    "",
    "/*PROC SQL;",
    "DELETE FROM Saldos_SI WHERE AÑO<>&ANIO;QUIT;",
    "",
    "/*define librería para dejar datos y filtra paño para ir actualizando solo lo que corresponda*/",
    "LIBNAME DCNIDATA META LIBRARY='DCNIDATA' METAOUT=DATA;",
    "",
    "PROC SQL;",
    "DELETE FROM DCNIDATA.SALDOS_WTW_SI WHERE AÑO>=&ANIO;QUIT;",
    "",
    "PROC DATASETS;",
    "APPEND BASE=DCNIDATA.SALDOS_WTW_SI DATA=Saldos_SI FORCE;",
    "RUN;",
    "",
    "",
    "data DCNIDATA.SALDOS_WTW_SI;set SALDOS_SI;RUN;",
    "",
    ""
  ]
}
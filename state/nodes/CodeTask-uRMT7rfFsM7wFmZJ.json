    "WHERE T1.C_Cuenta in('Bce Final')  AND T1.AÑO>2002\r",
    "GROUP BY CALCULATED AÑO,calculated Trim,T1.C_SI_Emisor,T1.C_SI_Tenedor,t1.C_INSTRUMENTO_SCN,t1.Entrada;\r",
    "QUIT;\r",

    "/*GENERA DATOS CONSISTENCIA BF=BI*/\r",
    "PROC SQL;/*SELECCIONA BF*/\r",
    "CREATE TABLE WORK.P_BF_T1 AS\r",
    "SELECT (CASE WHEN T1.TRIM IN (1,2,3) THEN T1.AÑO ELSE T1.AÑO+1 END) AS AÑO,\r",
    "\t   (CASE WHEN T1.TRIM IN (1,2,3) THEN T1.TRIM+1 ELSE 1 END) AS TRIM,\r",
    "\t\tT1.C_SI_Emisor,T1.C_SI_Tenedor,t1.C_INSTRUMENTO_SCN,t1.Entrada,\r",
    "\t\tSUM(T1.DATO*-1) FORMAT COMMA14.3 AS DATO \r",

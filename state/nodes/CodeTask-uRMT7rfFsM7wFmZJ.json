    "PROC SQL;\r",
    "CREATE TABLE WORK.T1 AS\r",
    "SELECT T1.AÑO,T1.TRIM, T1.C_SI_Emisor,T1.C_SI_Tenedor,t1.C_INSTRUMENTO_SCN,t1.Entrada,\r",
    "\tSUM(CASE WHEN T1.c_Cuenta<>'Bce Final' THEN T1.DATO*-1 ELSE T1.DATO END) FORMAT COMMA14.3 AS DATO \r",
    "FROM '/sasdata/BCCH/GEM_DCNI/02_CNSI/05_DCV/Data/DCVRES/t_aj_cd_321_6_AF32.sas7bdat'  T1 \r",
    "GROUP BY T1.AÑO,T1.TRIM, T1.C_SI_Emisor,T1.C_SI_Tenedor,t1.C_INSTRUMENTO_SCN,t1.Entrada;\r",
    "QUIT;\r",
    "\r",
    "/*TEST 1*/\r",
    "TITLE;\r",
    "TITLE1 \"CONSISTENCIA BALANCE (BF=BI+OF+RP+RV). TABLA:t_aj_cd_321_6_AF32\";\r",
    "TItLE2\t\t\"(Millones de pesos. Diferencias)\";\r",
    "FOOTNOTE;\r",
    "PROC TABULATE\r",
    "DATA=WORK.T1;\r",
    " WHERE (DATO>0.05 OR DATO<-0.05);\r",
    "\tVAR DATO ;\r",
    "\tCLASS C_SI_Emisor /\tORDER=FORMATTED MISSING;\r",
    "\tCLASS C_INSTRUMENTO_SCN /\tORDER=FORMATTED MISSING;\r",
    "\tCLASS Año /\tORDER=UNFORMATTED MISSING;\r",
    "\tCLASS TRIM /\tORDER=UNFORMATTED MISSING;\r",
    "\tCLASS ENTRADA /\tORDER=UNFORMATTED MISSING;\r",
    "\tCLASS C_SI_Tenedor /\tORDER=UNFORMATTED MISSING;\r",
    "\tTABLE \r",
    "\t\t/* ROW Statement */\r",
    "\t\tAño*TRIM*ENTRADA*C_SI_Emisor*C_SI_Tenedor,\r",
    "\t\t/* COLUMN Statement */\r",
    "\t\t(DATO={LABEL=\"\"}*F=COMMA14.* Sum={LABEL=\"\"}*F=COMMA14.);\r",
    "\t;RUN;RUN; QUIT;\r",
    "TITLE; FOOTNOTE;\r",
    "\r",
    "/*PROC SQL;\r",

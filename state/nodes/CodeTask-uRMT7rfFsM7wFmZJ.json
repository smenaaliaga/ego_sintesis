    "﻿/*revisa tablas dcv*/\r",
    "\r",
    "/*proc sql; create table ff as select * from  '/sasdata/BCCH/GEM_DCNI/02_CNSI/05_DCV/Data/DCVRES/t_aj_dcv_af31_act_c21.sas7bdat';quit; \r",

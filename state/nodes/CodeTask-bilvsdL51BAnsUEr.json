  "code_lines": [
    "﻿/*ARREGLA DATOS A PIB DE ANF PARA COMPARATIVO RESUMIDO*/\r",
    "\r",
    "data COMPARA_RES;set COMPARA_SC_PIBF; DROP delta NUEVA ANTERIOR ID; N_SCN_a=N_SCN_N1; c_scn_n2=substr(c_scn_n1,1,3);if c_cuenta not in ('Producción','Rec Precio','Rec Volumen','Bce Inicio'); run;\r",
    "\r",
    "proc sql; delete from COMPARA_RES where c_scn_n1='B.8' and c_cuenta='YG';quit;\r",
    "proc sql; update COMPARA_RES\r",
    "\tset version='1_Anterior'\r",
    "\twhere version in ('ANTERIOR');\r",
    "quit;\r",
    "proc sql; update COMPARA_RES\r",
    "\tset version='2_Nueva'\r",
    "\twhere version in ('NUEVA');\r",
    "quit;\r",
    "proc sql; update COMPARA_RES\r",
    "\tset version='3_Cambio'\r",
    "\twhere version in ('DELTA');\r",
    "quit;\r",
    "\r",
    "proc sql; update COMPARA_RES\r",
    "\tset c_scn_n2=substr(c_scn_n1,1,4)\r",
    "\twhere c_cuenta in ('Financiera','Bce Final');\r",
    "quit;\r",
    "\r",
    "proc sql; update COMPARA_RES\r",
    "\tset N_SCN_a='Ingreso empresarial'\r",
    "\twhere C_SI_SCN='S.11' and C_SCN_N1 IN('B.2');\r",
    "quit;\r",
    "\r",
    "proc sql; update COMPARA_RES\r",
    "\tset N_SCN_a='Ingreso empresarial'\r",
    "\twhere C_SI_SCN='S.11' and c_scn_n2=('D.4') and c_entrada='H';\r",
    "quit;\r",
    "proc sql; update COMPARA_RES\r",
    "\tset N_SCN_a='Ingreso empresarial'\r",
    "\twhere C_SI_SCN='S.11' and c_scn_n2=('D.4') and c_entrada='D' and C_SCN_N1 not in ('D.42','D.43');\r",
    "quit;\r",
    "proc sql; update COMPARA_RES\r",
    "\tset N_SCN_a='Ingreso disponible'\r",
    "\twhere C_SI_SCN in ('S.14','S.13','S.2') and c_cuenta=('YG') and  C_SCN_N1 not in ('D.63','D.8','P.4','P.31','P.32');\r",
    "quit;\r",
    "\r",
    "proc sql; update COMPARA_RES\r",
    "\tset N_SCN_a='Ingreso disponible'\r",
    "\twhere C_SI_SCN contains ('S.12') and c_cuenta=('YG') and  C_SCN_N1 not in ('D.63','D.8','P.4','P.31','P.32');\r",
    "quit;\r",
    "\r",
    "proc sql; update COMPARA_RES\r",
    "\tset N_SCN_a='Formación bruta de capital'\r",
    "\twhere C_SCN_N1 in ('P.51','P.52');\r",
    "quit;\r",
    "\r",
    "/*proc sql; update COMPARA_RES\r",

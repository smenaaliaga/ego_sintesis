  "code_lines": [
    "﻿ods graphics on / imagemap=on;\r",
    "\r",
    "/*CREA BASE CON INFO DE CUENTA FINANCIERA*/\r",
    "PROC SQL;\r",
    "CREATE TABLE WORK.FINANCIERA AS\r",
    "SELECT T1.AÑO,T1.TRIM,(substr(PUT(t1.'AÑO'n,CHAR4.),3,2) ||\".\"|| PUT(t1.TRIM,CHAR1.))  AS PERIODO,\r",
    "(CASE WHEN T1.C_CUENTA in ('Rec Precio','Rec Precio Reaj') THEN 'Revalorizaciones'\r",
    "\t  WHEN T1.C_CUENTA='Rec Volumen' THEN 'Otros'\r",
    "\t  WHEN T1.C_CUENTA='Bce Final' THEN 'Saldos' ELSE T1.C_CUENTA END) AS C_CUENTA,\r",
    "\tT1.C_ENTRADA,t2.C_SI_SCN,T2.N_SI_SCN,T4.C_SCN_N1,T4.N_SCN_N1,SUM(T1.DATO)/1000 FORMAT COMMA14. AS DATO \r",
    "FROM TABLAS.BD_CTSI T1 \r",
    "LEFT JOIN TABLAS.T_Sectorizacion T2 ON (T1.SECTOR=T2.C_SI) \r",
    "LEFT JOIN TABLAS.T_Instrumentos T4 ON (T1.C_SCN=T4.C_SCN) \r",
    "where T1.C_Cuenta in ('Bce Final','Financiera','Rec Precio','Rec Precio Reaj','Rec Volumen')  AND T1.AÑO>2002 \r",
    "GROUP BY T1.AÑO,T1.TRIM,CALCULATED C_CUENTA,T1.C_ENTRADA,t2.C_SI_SCN,T2.N_SI_SCN,T4.C_SCN_N1,T4.N_SCN_N1;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "CREATE TABLE WORK.PP AS\r",
    "SELECT T1.AÑO,T1.TRIM, COUNT(T1.DATO) AS ID FROM  WORK.FINANCIERA T1 WHERE T1.C_CUENTA='Financiera'\r",
    "GROUP BY T1.AÑO,T1.TRIM;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "CREATE TABLE WORK.FIN_ACUM AS\r",
    "SELECT T2.AÑO_ACUM,T2.TRIM_ACUM,(substr(PUT(T2.AÑO_ACUM,CHAR4.),3,2) ||\".\"|| PUT(T2.TRIM_ACUM,CHAR1.))  AS PERIODO,T1.C_CUENTA,\r",
    "\tT1.C_ENTRADA,t1.C_SI_SCN,T1.N_SI_SCN,T1.C_SCN_N1,T1.N_SCN_N1,SUM(T1.DATO) FORMAT COMMA14. AS DATO \r",
    "FROM WORK.FINANCIERA T1,TABLAS.TIEMPO T2,WORK.PP T3 \r",
    "WHERE (T1.AÑO=T2.AÑO AND T1.TRIM=T2.TRIM AND T2.TRIM_ACUM=T3.TRIM AND T2.AÑO_ACUM=T3.AÑO) AND T1.C_CUENTA<>'Saldos'\r",
    "GROUP BY T2.AÑO_ACUM,T2.TRIM_ACUM,T1.C_CUENTA,T1.C_ENTRADA,t1.C_SI_SCN,T1.N_SI_SCN,T1.C_SCN_N1,T1.N_SCN_N1;\r",
    "QUIT;\r",
    "/*CREA TABLA CON CÓDIGOS PARA FILTRO DE GRÁFICOS*/\r",
    "PROC SQL;\r",
    "   CREATE TABLE TABLAS.FILTROS AS \r",
    "   SELECT T1.C_SCN_N1,T1.N_SCN_N1, \r",
    "            (COUNT(t1.DATO)) AS COUNT\r",
    "      FROM WORK.FINANCIERA t1 \r",
    "      GROUP BY T1.C_SCN_N1,T1.N_SCN_N1\r",
    "\t  ORDER BY t1.C_SCN_N1;QUIT;\r",
    "\r",
    "/*GENERA GRÁFICOS NIVELES SALDOS*/\r",
    "\r",
    "PROC SQL;\r",
    "\tCREATE TABLE SALDOS_SECTOR AS\r",
    "\t\tSELECT T.PERIODO, T.N_SI_SCN,T.N_SCN_N1,t.C_ENTRADA, T.C_CUENTA,T.DATO label \"Saldos\" as DATO\r",
    "\tFROM WORK.FINANCIERA as T WHERE (T.C_SI_SCN=\"&Sector\" AND T.C_SCN_N1=\"&Codigo\" AND T.C_ENTRADA=\"&Entrada\" AND T.C_CUENTA='Saldos');\r",
    "QUIT;\r",
    "proc sgrender data=SALDOS_SECTOR template=template_chart1;\r",
    "\tdynamic VAR=\"DATO\" varlabel=\"Dato\" normal=\"yes\"\r",
    "\t\t\ttitle=\"SALDOS SECTOR:\"\r",
    "\t\t\ttitle2=\"&Sector - INSTRUMENTO: &Codigo - ACTIVO/PASIVO: &Entrada\"\r",
    "\t\t\ttitle3=\"(miles de millones de pesos)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "\r",
    "/*GRAFICO trimestral flujo FINANCIERO*/\r",
    "PROC SORT\r",
    "\tDATA=WORK.FINANCIERA (WHERE=(C_SI_SCN=\"&Sector\" AND C_SCN_N1=\"&Codigo\" AND C_ENTRADA=\"&Entrada\" AND C_CUENTA<>'Saldos') KEEP=PERIODO C_SI_SCN N_SI_SCN C_SCN_N1 N_SCN_N1 C_ENTRADA C_CUENTA DATO)   \r",
    "\tOUT=Financiera_d;\r",
    "\tBY C_CUENTA PERIODO ;\r",
    "RUN;\r",
    "%_sas_pushchartsize(600,400);\r",
    "SYMBOL1\r",
    "\tINTERPOL=JOIN HEIGHT=10pt VALUE=NONE LINE=1 WIDTH=3 CI=BLACK CV = _STYLE_;\r",
    "SYMBOL2\r",
    "\tINTERPOL=JOIN HEIGHT=10pt FONT=MARKER VALUE=NONE LINE=1 WIDTH=3 CI=BLUE CV = _STYLE_;\r",
    "SYMBOL3\r",
    "\tINTERPOL=JOIN HEIGHT=10pt FONT=MARKER VALUE=NONE LINE=20 WIDTH=3 CI=RED CV = _STYLE_;\r",
    "Axis1\r",
    "\tSTYLE=1\r",
    "\tWIDTH=1\r",
    "\tMINOR=NONE\r",
    "\tLABEL=NONE;\r",
    "Axis2\r",
    "\tSTYLE=1\r",
    "\tWIDTH=1\r",
    "\tMINOR=NONE\r",
    "\tLABEL=NONE;\r",
    "LEGEND1 LABEL=NONE;\r",
    "TITLE;\r",
    "TITLE1 \"OPERACIÓN FINANCIERA TRIMESTRAL\";\r",
    "TITLE2 \"SECTOR: &Sector - INSTRUMENTO: &Codigo - ACTIVO/PASIVO: &Entrada\";\r",
    "TITLE3 \"(miles de millones de pesos)\";\r",
    "PROC GPLOT DATA = FINANCIERA_D;\r",
    "PLOT DATO * PERIODO=C_CUENTA/VAXIS=AXIS1 HAXIS=AXIS2 FRAME\tLEGEND=LEGEND1;\r",
    "RUN; QUIT;\r",
    "%_sas_popchartsize;\r",
    "%_eg_conditional_dropds(WORK.SORTTempTableSorted);\r",
    "GOPTIONS RESET = SYMBOL;\r",
    "\r",
    "/*CREA GRÁFICO DE BARRAS PARA CAMBIOS EN EL BALANCE POR INSTRUMENTO*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE FIN_ACUM_A AS\r",
    "\t\tSELECT PERIODO, DATO, C_CUENTA AS GRUPO, C_ENTRADA, C_SI_SCN,N_SI_SCN,C_SCN_N1,N_SCN_N1\r",
    "\tFROM WORK.FIN_ACUM as T WHERE (T.C_SI_SCN=\"&Sector\" AND T.C_SCN_N1=\"&Codigo\" AND T.C_ENTRADA=\"&Entrada\");QUIT;\r",
    "PROC SQL;\r",
    "\tCREATE TABLE FIN_ACUM_2 AS\r",
    "\t\tSELECT PERIODO, DATO, GRUPO, SUM(DATO) FORMAT COMMA20. LABEL \"Cambio\" AS TOTAL\r",
    "\tFROM WORK.FIN_ACUM_A as T \r",
    "\t\tWHERE (T.C_SI_SCN=\"&Sector\" AND T.C_SCN_N1=\"&Codigo\" AND T.C_ENTRADA=\"&Entrada\")\r",
    "\tGROUP BY PERIODO;\r",
    "QUIT;\r",
    "proc sgrender data=FIN_ACUM_2 template=template_chart1;\r",
    "\tdynamic VAR=\"DATO\" varlabel=\"Dato\" normal=\"yes\"\r",
    "\t\t\tVAR2=\"TOTAL\" varlabel=\"Ahorro\" normal=\"yes\"\r",
    "\t\t\tVAR3=\"C_CUENTA\" varlabel=\"Grupo\" normal=\"yes\"\r",
    "\t\t\ttitle=\"CAMBIOS EN SALDOS\"\r",
    "\t\t\ttitle2=\"SECTOR: &Sector - INSTRUMENTO: &Codigo - ACTIVO/PASIVO: &Entrada\"\r",
    "\t\t\ttitle3=\"(miles de millones de pesos, acumulado)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "\r",
    "PROC SQL; DROP TABLE FIN_ACUM, FINANCIERA,PP,FIN_ACUM_A,FIN_ACUM_2,FINANCIERA_D,saldos_sector;QUIT;\r",
    "\r",
    ""
  ]
}
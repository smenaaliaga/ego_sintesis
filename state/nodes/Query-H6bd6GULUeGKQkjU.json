  "code_lines": [
    "PROC SQL;",
    "   CREATE TABLE TABLAS.t_inst_nf AS",
    "   SELECT t1.C_CUENTA,",
    "          t1.C_INSTRUMENTO_SCN_N1,",
    "          t1.N_INSTRUMENTO_SCN_N1,",
    "          /* COUNT_of_AÑO */",
    "            (COUNT(t1.'AÑO'n)) AS 'COUNT_of_AÑO'n,",
    "          /* ID */",
    "            (t1.C_CUENTA||\"\"||t1.C_INSTRUMENTO_SCN_N1||\"\"||t1.N_INSTRUMENTO_SCN_N1) AS ID",
    "      FROM WORK.SALIDA_WTW t1",
    "      WHERE t1.C_CUENTA IN",
    "           (",
    "           'YG',",
    "           'Producción',",
    "           'Capital'",
    "           )",
    "      GROUP BY t1.C_CUENTA,",
    "               t1.C_INSTRUMENTO_SCN_N1,",
    "               t1.N_INSTRUMENTO_SCN_N1,",
    "               (CALCULATED ID);",
    "QUIT;"
  ]
}
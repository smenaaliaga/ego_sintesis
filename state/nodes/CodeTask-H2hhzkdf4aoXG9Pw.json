  "code_lines": [
    "﻿/* \r",
    "Programa: Benchmarking \r",
    "Última modificación: 29/01/2020\r",
    "Procedimiento: Crea series ajustadas por el método Cholette-Dagum.\r",
    "Autores: Felipe Avilés, Carlos Correa, Camilo Levenier, Danae Scherman.\r",
    "\r",
    "Formula origina: function [Res]=chd_m(a,s,rho,lambda,bias,per)\r",
    "% a: datos referenciales con formato [año1 mes1 año2 mes2 valor] donde año1\r",
    "% es el año en que comienza la medicion de referencia, mes1 mes del año1 en\r",
    "% que comienza la referecnia, año2 es el año en que termina la medicion de\r",
    "% la misma referencia y mes2 el mes del año2 en que termina la medicion de\r",
    "% la referencia. Ej: la referencia es el 1er trim de 2006 y es 250, el dato\r",
    "% de esa fila debe ser [2006 1 2006 1 250] si es que los indicadores son\r",
    "% trimestrales y: [2006 1 2006 3 250] si los datos son mensuales\r",
    "% s: indicadores utilizados para distribuir a. en fomato [año mes/trimestre valor]\r",
    "% rho: es el valor de autocorrelación par ala distribución de las\r",
    "% diferencias (para denton es 1)\r",
    "% lambda: es el parámetro de ajuste que asigna valores de distribución de\r",
    "% las diferencias a cada registro de acuerdo a su peso relativo en la serie\r",
    "% (para denton proporcional es 1, para denton clásico es 0)\r",
    "% bias: especifica si se calculara y/o usarán las diferencias para el\r",
    "% ajuste. bias=3 implica calculo y uso.\r",
    "En IMACEC se usa: [Res]=chd_m(a,s,0,999,1,3)\r",
    "En CNSI se usa: [Res]=chd_m(a,s,0,9999,0,1)\r",
    "*/\r",
    "/*Declara parametros para llamar bases de datos*/\r",
    "\r",
    "\t\r",
    "\r",
    "%let rho = 0.9999;\r",
    "\r",
    " \r",
    "\r",
    "proc iml;\t\r",
    "\t /*Matriz indicadores*/\r",
    "     use IND;/*tabla de datos*/\r",
    "     read all into PT;\r",
    "\t nc = ncol(PT);\r",
    "\t np = nrow(PT);\r",
    "\t /*Matriz restricciones*/\r",
    "\t use RES;/*tabla de datos*/\r",
    "     read all into AT;\r",
    "\t /*Matriz de resultados*/\r",
    "\t OUTT = J(np,nc,0);\r",
    "\t /*Las dos primeras columnas son año y mes*/\r",
    "\t OUTT[,1:2] = PT[,1:2];\r",
    "\r",
    "\t /*# de restricciones*/\r",
    "\t na = nrow(AT);\r",
    "\t /*Año comienzo serie*/\r",
    "\t syear = PT[1,1];\r",
    "\t /*Mes/Trimestre comienzo serie*/\r",
    "\t smonth = PT[1,2];\r",
    "\t /*Año término serie con restricción*/\r",
    "\t eyear = AT[na,3];\r",
    "\t /*Mes/Trimestre término serie con restricción*/\r",
    "\t emonth = AT[na,4];\r",
    "\t\r",
    "\t /*# de observaciones por año*/\r",
    "\t noa = sum(PT[,1]=PT[1,1]);\r",
    "\r",
    "\t /*# observaciones con restricción*/\r",
    "\t if noa = 12 then\r",
    "\t \tmna = sum(AT[,4] - AT[,2] + 1);\r",
    "\t else if noa = 4 then\r",
    "\t \tmna = na*4;\r",
    "\r",
    "\t /*Matriz de agregación generalizada*/\r",
    "\t J = J(na,mna,0);\r",
    "     if noa = 12 then\r",
    "\t\t do k = 1 to na;\r",
    "\t\t \tri = noa*(AT[k,1]-syear) + AT[k,2];;\r",
    "\t\t\trf = noa*(AT[k,3]-syear) + AT[k,4];\r",
    "\t\t\tJ[k,ri:rf] = 1;\r",
    "\t\t end;\r",
    "\t else if noa = 4 then\r",
    "\t \tJ = I(na)@J(1,4,1);\r",
    "\t J2 = J;\r",
    " \t /*Loop Bench (por serie)*/\r",
    "\t ncp = ncol(PT)-2;\r",
    "\t do i = 1 to ncp;\r",
    "\t\tP = PT[,i+2];\r",
    "\t\tA = AT[,i+4];\r",
    "\t\t/*Si rho<1, Cholette-Dagum*/\r",
    "\t\tif &rho < 1 then\r",
    "\t\t\tdo;\r",
    "\t\t    sa = sum(A);\t\t\r",
    "     \t\tsp = sum(P[1:mna]);\r",
    "\t\t    /*Sesgo histórico */\r",
    "\t     \td = sa/sp;\r",
    "\t\t\t/*Imputación datos con sesgo histórico*/\r",
    "\t     \tPA = d*P[1:mna];\r",
    "\t    \t/*Matriz de varianza y covarianza proceso AR(1) */\r",
    "\t     \tW = I(mna);\r",
    "\t     \t\tdo k = 1 to mna;\r",
    "\t        \t\tif k = 1 then\r",
    "\t            \t    W[k,k] = sqrt(1-&rho**2);\r",
    "\t          \t\telse W[k,k-1] = -&rho;\r",
    "\t     \t\tend;\r",
    "\t     \tWW = W`*W;\r",
    "\t     \tV = diag(PA)*solve(WW,diag(PA));\r",
    "\t        /*Vector de resultado de proceso de benchmarking */\r",
    "\t     \tOUT = PA+V*J`*sweep(J*V*J`)*(A-J*PA);\r",
    "\t        /*Extrapolación */\r",
    "\t\t\tif np > mna then\r",
    "\t\t\t\tdo;\r",
    "\t\t\t \t \tE = J(np-mna,1,0);\r",
    "\t\t\t\t \terror = (PA[mna,1]-OUT[mna,1])/PA[mna,1];\r",
    "\t\t\t\t \t\tdo z = 1 to np-mna;\r",
    "\t\t\t\t \t\t\tE[z,1] = d*(1-(&rho**z)*error)*P[mna+z,1];\r",
    "\t\t\t\t \t\tend;\r",
    "\t\t\t\t\tOUT = OUT // E;\r",
    "\t\t\t\tend;\r",
    "\t        OUTT[,i+2] = OUT;\r",
    "\t\t\tend;\r",
    "\r",
    "\t\t/*Si rho=1, Denton*/\r",
    "\t\telse if &rho = 1 then\r",
    "\t\t\tdo;\r",
    "\t\t\t/*Matriz de diferencias*/\r",
    "        \tDD = J(mna-1,mna,0);\r",
    "\t\t\t\tdo k = 1 to (mna-1);\r",
    "\t\t\t \t\tDD[k,k] = -1;\r",
    "\t\t\t    \tDD[k,k+1] = 1;\r",
    "\t\t\t\tend;\r",
    "\t\t\t/*Solución*/\r",
    "\t\t\tDPA = diag(P[1:mna]);\t\t\t\r",
    "\t\t\tMM = GINV(DPA)*(DD`*DD)*GINV(DPA);\r",
    "\t\t\tQQ = (MM || J`) // (J || J(na,na,0));\r",
    "      \t\tVV = MM*J(mna,1,1) // A;\r",
    "\t\t \tXX = solve(QQ,VV);\r",
    "\t\t\tOUT = XX[1:mna,];\r",
    "\t\t\t/*Extrapolación*/\r",
    "\t\t\tif np > mna then\r",
    "\t\t\t\tdo;\r",
    "\t\t\t\t\tk = OUT[mna,]/P[mna,];\r",
    "\t\t\t\t\tE = k*P[mna+1:np,];\r",
    "\t\t\t\t\tOUT = OUT // E;\r",
    "\t\t\t\tend;\r",
    "\t        OUTT[,i+2] = OUT; \r",
    "\t\t\tend;\r",
    "\tend;\r",
    "\tprint outt;\r",
    "\r",
    "/*Tabla de resultados*/\r",
    "create OUTT from OUTT;\r",
    "append from OUTT;\r",
    "close OUTT;\t\r",
    "\r",
    "/*Cierra conexiones*/\r",
    "close IND;\r",
    "close RES;\r",
    "\r",
    "/*Tabla de resultados bench*/\r",
    "data bench;\r",
    "\tset IND;\r",
    "run;\r",
    "\r",
    "proc sql;\r",
    "\tdelete from bench;\r",
    "quit;\r",
    "\r",
    "proc sql;\r",
    "\tinsert into bench select * from outt;\r",
    "quit;\r",
    "\r",
    "proc delete data=outt;\r",
    "run;\r",
    "/*Fin*/"
  ]
}
  "code_lines": [
    "﻿/*CREA RATIO DE AJCON A PIB-ACUMULADO*/\r",
    "ods graphics / imagemap;\r",
    "\r",
    "PROC SQL;\r",
    "CREATE TABLE WORK.AF71_ACUM AS\r",
    "SELECT T2.AÑO_ACUM,T2.TRIM_ACUM,(substr(PUT(t1.'AÑO'n,CHAR4.),3,2) ||\".\"|| PUT(t1.TRIM,CHAR1.))  AS PERIODO,\r",
    "\tT1.C_ENTRADA,T1.C_SI_SCN_N1,T1.N_SI_SCN_N1, \r",
    "   SUM(T1.RATIO) FORMAT PERCENT.2 AS RATIO_Z\r",
    "FROM WORK.AF71 T1,TABLAS.TIEMPO T2,WORK.PIB T3 \r",
    "WHERE T1.AÑO=T2.AÑO AND T1.TRIM=T2.TRIM AND T2.AÑO_ACUM>2002 AND T2.AÑO_ACUM=T3.AÑO AND T2.TRIM_ACUM=T3.TRIM\r",
    "GROUP BY T2.AÑO_ACUM,T2.TRIM_ACUM,T1.C_ENTRADA,T1.C_SI_SCN_N1,T1.N_SI_SCN_N1,CALCULATED PERIODO;\r",
    "QUIT;\r",
    "proc sql; delete from AF71_acum where año_acum=&ANIO and trim_acum>&TRIM;quit;\r",
    "proc sql; delete from AF71_acum where año_acum>&ANIO;quit;\r",
    "/*GRAFICOS AJUSTE CONCILIACIÓN ANUAL*/\r",
    "PROC SORT\r",
    "\tDATA=WORK.AF71_ACUM(KEEP=PERIODO RATIO_Z N_SI_SCN_N1)\r",
    "\tOUT=WORK.SORTTempTableSorted;\r",
    "\tBY N_SI_SCN_N1;\r",
    "RUN;\r",
    "Legend2 FRAME;\r",
    "Legend1 FRAME;\r",
    "Axis1\r",
    "\tSTYLE=1\r",
    "\tWIDTH=1\r",
    "\tMINOR=NONE\r",
    "\tLABEL=NONE;\r",
    "Axis2\r",
    "\tSTYLE=1\r",
    "\tWIDTH=1 \tMINOR=NONE\r",
    "\tLABEL=NONE;\r",
    "TITLE \"Acumulado\";\r",
    "TITLE1 \"Acumulado - Sector: #BYVAL(N_SI_SCN_N1)\";\r",
    "TITLE2;TITLE3;\r",
    "FOOTNOTE;\r",
    "OPTIONS NOBYLINE;\r",
    "PROC GCHART DATA=WORK.SORTTempTableSorted\r",
    ";\r",
    "\tVBAR PERIODO/\tSUMVAR=RATIO_Z\r",
    "\tCLIPREF\r",
    "FRAME\tTYPE=SUM\r",
    "\tCOUTLINE=SAME\r",
    "\tRAXIS=AXIS1\r",
    "\tMAXIS=AXIS2\r",
    "\tLREF=1\r",
    "\tCREF=BLACK\r",
    "\tAUTOREF\r",
    "\tREF=0.005 -0.005\r",
    ";\t/*LABEL N_SI_SCN_N1=\"Sector\";*/\r",
    "\tBY N_SI_SCN_N1;\r",
    "RUN; QUIT;\r",
    "%_eg_conditional_dropds(WORK.SORTTempTableSorted);\r",
    "TITLE; FOOTNOTE;\r",
    "/*GRAFICOS AJUSTE CONCILIACIÓN ANUAL EMPRESAS + HOGARES*/\r",
    "PROC SORT\r",
    "\tDATA=WORK.AF71_ACUM(KEEP=PERIODO RATIO_Z C_SI_SCN_N1 WHERE=(C_SI_SCN_N1 IN ('S.14','S.11')))\r",
    "\tOUT=WORK.AF71_EH_AC;\r",
    "\tBY C_SI_SCN_N1;\r",
    "RUN;\r",
    "Legend2 FRAME;\r",
    "Legend1 FRAME;\r",
    "Axis1\r",
    "\tSTYLE=1\r",
    "\tWIDTH=1\r",
    "\tMINOR=NONE\r",
    "\tLABEL=NONE;\r",
    "Axis2\r",
    "\tSTYLE=1\r",
    "\tWIDTH=1 \tMINOR=NONE\r",
    "\tLABEL=NONE;\r",
    "TITLE;\r",
    "TITLE1 \"Sector=Empresas y Hogares\";\r",
    "TITLE2;\r",
    "FOOTNOTE;\r",
    "PROC GCHART DATA=WORK.AF71_EH_AC;\r",
    "\tVBAR PERIODO/\tSUMVAR=RATIO_Z\r",
    "\tCLIPREF\r",
    "FRAME\tTYPE=SUM\r",
    "\tCOUTLINE=SAME\r",
    "\tRAXIS=AXIS1\r",
    "\tMAXIS=AXIS2\r",
    "\tLREF=1\r",
    "\tCREF=BLACK\r",
    "\tAUTOREF\r",
    "\tREF=0.005 -0.005\r",
    ";RUN; QUIT;\r",
    "%_eg_conditional_dropds(WORK.SORTTempTableSorted);\r",
    "TITLE; FOOTNOTE;\r",
    "PROC SQL; DROP TABLE AF71_ACUM;DROP TABLE AF71; DROP TABLE AF71_EH_AC;QUIT;\r",
    "\r",
    "\r",
    "\r",
    ""
  ]

  "code_lines": [
    "﻿/*GENERA DATOS CONSISTENCIA BALANCE*/",
    "PROC SQL;",
    "CREATE TABLE WORK.P_FIN AS",
    "SELECT T1.AÑO,T1.TRIM, T1.C_SCN,T4.N_SCN,T1.C_ENTRADA,T2.C_SI_SCN,T2.N_SI_SCN, T3.C_SI_SCN AS C_SI_SCN_C_AGENTE, T3.N_SI_SCN AS N_SI_SCN_C_AGENTE,",
    "\tSUM(CASE WHEN T1.C_CUENTA<>'Bce Final' THEN T1.DATO*-1 ELSE T1.DATO END)/1000 FORMAT COMMA14.3 AS DATO ",
    "FROM TABLAS.BD_CTSI T1 ",
    "LEFT JOIN TABLAS.T_Sectorizacion T2 ON (T1.SECTOR=T2.C_SI) ",
    "LEFT JOIN TABLAS.T_Instrumentos T4 ON (T1.C_SCN=T4.C_SCN) ",
    "LEFT JOIN TABLAS.T_Contrapartidas T3 ON (T1.C_CAGENTE=T3.C_CAGENTE) ",
    "where T1.C_Cuenta NOT IN ('Capital','YG','Producción')  AND T1.AÑO>2002",
    "GROUP BY T1.AÑO,T1.TRIM,T1.C_SCN,T4.N_SCN,T1.C_ENTRADA,T2.C_SI_SCN,T2.N_SI_SCN,T3.C_SI_SCN, T3.N_SI_SCN;",
    "QUIT;",
    "/*TABLA*/",
    "TITLE;",
    "TITLE1 \"CONSISTENCIA BALANCE (BF=BI+OF+RP+RV)\";",
    "TItLE2\t\t\"(Miles de millones de pesos. Diferencias)\";",
    "FOOTNOTE;",
    "PROC TABULATE",
    "DATA=WORK.P_FIN;",
    " WHERE (DATO>0.05 OR DATO<-0.05) AND C_SCN NOT IN ('B.10.2','B.10.3','B.9','B.90');",
    "\tVAR DATO ;",
    "\tCLASS C_SI_SCN /\tORDER=FORMATTED MISSING;",
    "\tCLASS N_SI_SCN/\tORDER=UNFORMATTED MISSING;",
    "\tCLASS C_SCN /\tORDER=FORMATTED MISSING;",
    "\tCLASS N_SCN /\tORDER=FORMATTED MISSING;",
    "\tCLASS \"AÑO\"n /\tORDER=UNFORMATTED MISSING;",
    "\tCLASS TRIM /\tORDER=UNFORMATTED MISSING;",
    "\tCLASS C_ENTRADA /\tORDER=UNFORMATTED MISSING;",
    "\tCLASS C_SI_SCN_C_AGENTE /\tORDER=UNFORMATTED MISSING;",
    "\tCLASS N_SI_SCN_C_AGENTE /\tORDER=UNFORMATTED MISSING;",
    "\tTABLE ",
    "\t\t/* ROW Statement */",
    "\t\tAÑO*TRIM*C_ENTRADA*C_SCN*N_SCN*C_SI_SCN*N_SI_SCN*C_SI_SCN_C_AGENTE={LABEL=\"C_CAGENTE\"}*N_SI_SCN_C_AGENTE={LABEL=\"N_CAGENTE\"},",
    "\t\t/* COLUMN Statement */",
    "\t\t(DATO={LABEL=\"\"}*F=COMMA14.* Sum={LABEL=\"\"}*F=COMMA14.);",
    "\t;RUN;RUN; QUIT;",
    "TITLE; FOOTNOTE;",
    "",
    "/*GENERA DATOS CONSISTENCIA D=H*/",
    "PROC SQL;",
    "CREATE TABLE WORK.P_DH AS",
    "SELECT T1.AÑO,T1.TRIM, T1.C_SCN,T4.N_SCN,",
    "     (CASE WHEN T1.C_CUENTA IN('Rec Precio','Rec Precio Reaj','Rec Volumen') THEN 'Otros'  ELSE T1.C_CUENTA END) AS C_CUENTA,",
    "\tSUM(CASE WHEN T1.C_ENTRADA<>'D' THEN T1.DATO*-1 ELSE T1.DATO END)/1000 FORMAT COMMA14.3 AS DATO ",
    "FROM TABLAS.BD_CTSI T1 ",
    "LEFT JOIN TABLAS.T_Instrumentos T4 ON (T1.C_SCN=T4.C_SCN) ",
    "where T1.C_Cuenta NOT IN ('Capital','YG','Producción')  AND T1.AÑO>2002 AND T1.C_SCN NOT IN ('B.10.2','B.10.3')",
    "GROUP BY T1.AÑO,T1.TRIM,T1.C_SCN,T4.N_SCN,CALCULATED C_CUENTA;",
    "QUIT;",
    "",
    "",
    "",
    "/*TABLA*/",
    "TITLE;",
    "TITLE1 \"CONSISTENCIA D=H POR INSTRUMENTO\";",
    "TItLE2\t\t\"(Miles de millones de pesos. Diferencias)\";",
    "FOOTNOTE;",
    "PROC TABULATE",
    "DATA=WORK.P_DH;",
    " WHERE DATO>0.05 OR DATO<-0.05;",
    "\tVAR DATO ;",
    "\tCLASS C_SCN /\tORDER=FORMATTED MISSING;",
    "\tCLASS N_SCN /\tORDER=FORMATTED MISSING;",
    "\tCLASS \"AÑO\"n /\tORDER=UNFORMATTED MISSING;",
    "\tCLASS TRIM /\tORDER=UNFORMATTED MISSING;",
    "\tTABLE ",
    "\t\t/* ROW Statement */",
    "\t\tAÑO*TRIM*C_SCN*N_SCN,",
    "\t\t/* COLUMN Statement */",
    "\t\t(DATO={LABEL=\"\"}*F=COMMA14.* Sum={LABEL=\"\"}*F=COMMA14.);",
    "\t;RUN;RUN; QUIT;",
    "TITLE; FOOTNOTE;",
    "/*GENERA DATOS CONSISTENCIA BF=BI*/",
    "PROC SQL;/*SELECCIONA BF*/",
    "CREATE TABLE WORK.P_BF AS",
    "SELECT (CASE WHEN T1.TRIM IN (1,2,3) THEN T1.AÑO ELSE T1.AÑO+1 END) AS AÑO,",
    "\t   (CASE WHEN T1.TRIM IN (1,2,3) THEN T1.TRIM+1 ELSE 1 END) AS TRIM,",
    "\t\tT1.C_SCN,T2.C_SI_SCN,T2.N_SI_SCN,T1.C_ENTRADA,",
    "\t\tSUM(T1.DATO*-1)/1000 FORMAT COMMA14.3 AS DATO ",
    "FROM TABLAS.BD_CTSI T1 ",
    "LEFT JOIN TABLAS.T_Sectorizacion T2 ON (T1.SECTOR=T2.C_SI) ",
    "",
    "WHERE T1.C_Cuenta in('Bce Final')  AND T1.AÑO>2002 AND T1.C_SCN NOT IN ('B.10.2','B.10.3')",
    "GROUP BY CALCULATED AÑO,T1.TRIM,T1.C_SCN,T2.C_SI_SCN,T2.N_SI_SCN,T1.C_ENTRADA;",
    "QUIT;",
    "PROC SQL;/*SELECCIONA BI*/",
    "CREATE TABLE WORK.P_BI AS",
    "SELECT T1.AÑO,T1.TRIM, T1.C_SCN,T2.C_SI_SCN,T2.N_SI_SCN,T1.C_ENTRADA,",
    "\t\tSUM(T1.DATO)/1000 FORMAT COMMA14.3 AS DATO ",
    "FROM TABLAS.BD_CTSI T1 ",
    "LEFT JOIN TABLAS.T_Sectorizacion T2 ON (T1.SECTOR=T2.C_SI) ",
    "",
    "where T1.C_Cuenta in('Bce Inicio')  AND T1.AÑO>2002 AND T1.C_SCN NOT IN ('B.10.2','B.10.3')",
    "GROUP BY T1.AÑO,T1.TRIM,T1.C_SCN,T2.C_SI_SCN,T2.N_SI_SCN,T1.C_ENTRADA;",
    "QUIT;",
    "PROC SQL;/*UNE BF Y BI PARA CALCULAR DIFERENCIAS*/",
    "CREATE TABLE WORK.P_BF_BI_ AS ",
    "SELECT * FROM WORK.P_BF OUTER UNION CORR SELECT * FROM WORK.P_BI;",
    "QUIT;",
    "PROC SQL;/*CALCULA DIF BI-BF*/",
    "CREATE TABLE WORK.P_BF_BI AS",
    "SELECT T1.AÑO,T1.TRIM, T1.C_SCN,T1.C_SI_SCN,T1.N_SI_SCN,T1.C_ENTRADA,SUM(T1.DATO)FORMAT COMMA14.3 AS DATO ",
    "FROM WORK.P_BF_BI_ T1 ",
    "GROUP BY T1.AÑO,T1.TRIM,T1.C_SCN,T1.C_SI_SCN,T1.N_SI_SCN,T1.C_ENTRADA;",
    "QUIT;",
    "/*TABLA TEST BF BI POR INSTRUMENTO Y SECTOR*/",
    "TITLE;",
    "TITLE1 \"CONSISTENCIA BF/BI POR INSTRUMENTO Y SECTOR\";",
    "TItLE2\t\t\"(Miles de millones de pesos. Diferencias)\";",
    "FOOTNOTE;",
    "PROC TABULATE",
    "DATA=WORK.P_BF_BI;",
    "WHERE DATO>0.05 OR DATO<-0.05;",
    "\tVAR DATO;",
    "\tCLASS C_SCN /\tORDER=FORMATTED MISSING;",
    "\tCLASS C_ENTRADA /\tORDER=FORMATTED MISSING;",
    "\tCLASS C_SI_SCN /\tORDER=FORMATTED MISSING;",
    "\tCLASS \"AÑO\"n /\tORDER=UNFORMATTED MISSING;",
    "\tCLASS TRIM /\tORDER=UNFORMATTED MISSING;",
    "\tTABLE ",
    "\t\t/* ROW Statement */",
    "\t\tC_SI_SCN*C_ENTRADA*C_SCN,",
    "\t\t/* COLUMN Statement */",
    "\t\tAÑO={LABEL=\"\"}*TRIM={LABEL=\"\"}*(DATO={LABEL=\"\"}*F=COMMA14.1* Sum={LABEL=\"\"}*F=COMMA14.1);",
    "\t;RUN;RUN; QUIT;",
    "TITLE; FOOTNOTE;",
    "PROC SQL; DROP TABLE P_BF; DROP TABLE P_BI; DROP TABLE P_BF_BI_;QUIT;"
  ]
}
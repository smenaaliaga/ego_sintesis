  "code_lines": [
    "﻿/*SALDOS DE INSTRUMENTOS FINANCIEROS POR SECTOR-INSTRUMENTO-CONTRAGENTE*/",
    "PROC SQL;",
    "CREATE TABLE Saldos_SI AS",
    "SELECT T1.AÑO,T1.TRIM,(PUT(t1.'AÑO'n,CHAR4.) ||\".\"|| PUT(t1.TRIM,CHAR1.)) AS PERIODO,T2.C_SI_SCN as C_Sector_pub,T2.N_SI_SCN as N_Sector_pub,",
    "\tT4.C_SCN_N1,T4.N_SCN_N1,T4.C_SCN_N0,T4.N_SCN_N0,T3.C_SI_SCN AS N_SI_C_AGENTE,T3.N_SI_SCN AS C_SI_C_AGENTE,",
    "\t(CASE WHEN T4.C_SCN_N1 CONTAINS 'AF.52' THEN 'Cuotas de fondos'",
    "\t\t WHEN T4.C_SCN_N1 IN ('AF.612') THEN 'Fondos de pensiones' ELSE T4.N_SCN_N0 END) AS N_SCN_N2,",
    "\t\t \tT1.C_ENTRADA,",
    "\tSUM(T1.DATO)/1000 FORMAT COMMA14. AS DATO",
    "FROM TABLAS.BD_CTSI T1 ",
    "LEFT JOIN TABLAS.T_Sectorizacion T2 ON (T1.SECTOR=T2.C_SI) ",
    "LEFT JOIN TABLAS.T_Instrumentos T4 ON (T1.C_SCN=T4.C_SCN) ",
    "LEFT JOIN TABLAS.T_Contrapartidas T3 ON (T1.C_CAGENTE=T3.C_CAGENTE) ",
    "where T1.C_Cuenta=('Bce Final')  AND T1.AÑO>2002 AND T1.C_SCN <>('B.90')  /*AND T2.C_SI_SCN_N1='S.12'*/",
    "GROUP BY T1.AÑO,T1.TRIM,T4.C_SCN_N1,T4.N_SCN_N1,T3.C_SI_SCN,T3.N_SI_SCN,T4.C_SCN_N0,T4.N_SCN_N0,T1.C_ENTRADA,T2.C_SI_SCN,T2.N_SI_SCN;",
    "QUIT;",
    "",
    "/*SALDOS DE INSTRUMENTOS FINANCIEROS POR SECTOR-INSTRUMENTO*/",
    "PROC SQL;",
    "CREATE TABLE Saldos_SI_INST AS",
    "SELECT T1.AÑO,T1.TRIM,T1.PERIODO,T1.C_Sector_pub,T1.N_Sector_pub,",
    "\tT1.C_SCN_N1,T1.N_SCN_N1,T1.C_SCN_N0,T1.N_SCN_N0,T1.C_ENTRADA,",
    "\tSUM(T1.DATO)  AS DATO",
    "FROM Saldos_SI T1 ",
    "GROUP BY T1.AÑO,T1.TRIM,T1.PERIODO,T1.C_Sector_pub,T1.N_Sector_pub,T1.C_SCN_N1,T1.N_SCN_N1,T1.C_SCN_N0,T1.N_SCN_N0,T1.C_ENTRADA;",
    "QUIT;",
    "proc sql; drop table Saldos_SI;quit;",
    "/*REVISA SALDOS NEGATIVOS*/",
    "TITLE;",
    "TITLE1 \"SALDOS NEGATIVOS\";",
    "TItLE2\t\t\"(Miles de millones de pesos)\";",
    "FOOTNOTE;",
    "PROC TABULATE",
    "DATA=Saldos_SI_INST;",
    " WHERE (DATO<0 AND C_SCN_N1<>'AF.34');",
    "\tVAR DATO;",
    "\tCLASS \"AÑO\"n /\tORDER=UNFORMATTED MISSING;",
    "\tCLASS TRIM /\tORDER=UNFORMATTED MISSING;",
    "\tCLASS c_Sector_pub /\tORDER=UNFORMATTED MISSING;",
    "\tCLASS C_SCN_N1 /\tORDER=UNFORMATTED MISSING;",
    "\tCLASS C_ENTRADA /\tORDER=UNFORMATTED MISSING;",
    "",
    "\tTABLE ",
    "\t\t/* ROW Statement */",
    "\t\tAÑO*TRIM,",
    "\t\t/* COLUMN Statement */",
    "\t\tc_Sector_pub={LABEL=\"\"}*C_ENTRADA={LABEL=\"\"}*C_SCN_N1={LABEL=\"\"}*(DATO={LABEL=\"\"}*F=COMMA14.0* Sum={LABEL=\"\"}*F=COMMA14.0);",
    "\t;RUN;RUN; QUIT;",
    "TITLE; FOOTNOTE;",
    ""
  ]
}
  "code_lines": [
    "﻿/*COMPRIME TABLA PRINCIPAL*/",
    "DATA tablas.BD_CTSI (COMPRESS=YES); SET tablas.BD_CTSI; RUN;",
    "/*CAMBIA CONTRAGENTE 511 EN EL PATRIMONIO DE EMPRESAS SUPERVISADAS A 53 PARA RECLACULAR LA PARTE QUE VA A HOGARES EN BASE AL % DEL TOTAL DEL PAT DE EMPRESAS*/",
    "PROC SQL; UPDATE TABLAS.BD_CTSI SET C_CAGENTE='53',PROC='0014' WHERE C_CAGENTE='511' AND C_SCN='AF.5' AND C_ENTRADA='H' AND SECTOR=51021;QUIT;",
    "/*CIERRE 2020. ELIMINA PASIVO Y ACTIVO AF7 DE EMPRESAS HOGARES CON CONTRAGENTE HOGARES*/",
    "PROC SQL; DELETE FROM  TABLAS.BD_CTSI WHERE SECTOR=5111 AND C_SCN='AF.7' AND C_CAGENTE='511';QUIT;",
    "",
    "/*CIERRE 2021: ELIMINA CONTRAGENTE HOGARES EN PATRIMONIO DE RESTO DE EMPRESAS SECTOR 51022, PORQUE LE GENERA MUCHA VOLATILIDAD AL SECTOR*/",
    "PROC SQL; UPDATE TABLAS.BD_CTSI SET C_CAGENTE='53',PROC='0014a' WHERE C_CAGENTE='511' AND C_SCN='AF.5' AND C_ENTRADA='H' AND SECTOR=51022;QUIT;",
    "",
    "/*CIERRE 2021: EN EMPRESAS HOGARES (SECTOR 5111)DEJA TODO EL PATRIMONIO PARA HOGARES (LO DEJA EN CA 53 PARA QUE LO IMPUTE PORQUE ASÍ ESTABA ANTES*/",
    "PROC SQL; UPDATE TABLAS.BD_CTSI SET C_CAGENTE='53',PROC='0014b' WHERE C_SCN='AF.5' AND C_ENTRADA='H' AND SECTOR=5111;QUIT;",
    "",
    "/*CIERRE 2021: AJUSTA PATRIMONIO DE SECTOR 36912 ASIGNADO A HOGARES EN 1/3 YA QUE ES MUY VOLÁTIL Y DISTORSIONA LA CTA FINANCIERA. LA DIFERENCIA SE LLEVA A CONTRAGENTE 36912 y 53*/",
    "PROC SQL;/*calcula patrimonio ajustado a hogares*/",
    "CREATE TABLE pat_36912_hh AS /*ajusta patrimonio con hogares*/",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM, ",
    "    \t  t1.SECTOR,",
    "\t\t   t1.C_CAGENTE,",
    "\t\t\tt1.C_CUENTA,",
    "\t\t\tt1.C_ENTRADA,\t\t\t",
    "\t\t\tSUM(T1.DATO)/3 AS DATO,",
    "\t\t\tT1.C_SCN,",
    "           T1.N_SCN,",
    "\t\t   'PS' AS FUENTE,\t",
    "\t\t   '0014d' AS PROC",
    "FROM TABLAS.BD_CTSI t1",
    "   WHERE T1.C_CAGENTE IN('511') AND T1.C_ENTRADA='H' AND T1.C_SCN='AF.5' AND T1.SECTOR=36912",
    "\tGROUP BY T1.MONEDA,t1.'AÑO'n, T1.TRIM,t1.SECTOR,t1.C_CAGENTE,",
    "\t\t     T1.C_CUENTA, t1.C_ENTRADA,T1.C_SCN,",
    "           T1.N_SCN;",
    "QUIT;",
    "PROC SQL;",
    "CREATE TABLE pat_36912_36 AS /*deja 1/3 en ca 36912*/",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM, ",
    "    \t  t1.SECTOR,",
    "\t\t   '36912' as C_CAGENTE,",
    "\t\t\tt1.C_CUENTA,",
    "\t\t\tt1.C_ENTRADA,\t\t\t",
    "\t\t\tSUM(T1.DATO)*1/3 AS DATO,",
    "\t\t\tT1.C_SCN,",
    "           T1.N_SCN,",
    "\t\t   'PS' AS FUENTE,\t",
    "\t\t   '0014e' AS PROC",
    "FROM TABLAS.BD_CTSI t1",
    "   WHERE T1.C_CAGENTE IN('511') AND T1.C_ENTRADA='H' AND T1.C_SCN='AF.5' AND T1.SECTOR=36912",
    "\tGROUP BY T1.MONEDA,t1.'AÑO'n, T1.TRIM,t1.SECTOR,t1.C_CAGENTE,",
    "\t\t     T1.C_CUENTA, t1.C_ENTRADA,T1.C_SCN,",
    "           T1.N_SCN;",
    "QUIT;",
    "PROC SQL;",
    "CREATE TABLE pat_36912_53 AS /*deja 1/3 en ca 53*/",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM, ",
    "    \t  t1.SECTOR,",
    "\t\t   '53' as C_CAGENTE,",
    "\t\t\tt1.C_CUENTA,",
    "\t\t\tt1.C_ENTRADA,\t\t\t",
    "\t\t\tSUM(T1.DATO)*1/3 AS DATO,",
    "\t\t\tT1.C_SCN,",
    "           T1.N_SCN,",
    "\t\t   'PS' AS FUENTE,\t",
    "\t\t   '0014e' AS PROC",
    "FROM TABLAS.BD_CTSI t1",
    "   WHERE T1.C_CAGENTE IN('511') AND T1.C_ENTRADA='H' AND T1.C_SCN='AF.5' AND T1.SECTOR=36912",
    "\tGROUP BY T1.MONEDA,t1.'AÑO'n, T1.TRIM,t1.SECTOR,t1.C_CAGENTE,",
    "\t\t     T1.C_CUENTA, t1.C_ENTRADA,T1.C_SCN,",
    "           T1.N_SCN;",
    "QUIT;",
    "PROC SQL;/*elimina patrimonio inicial asignado a hogares*/",
    "CREATE TABLE pat_36912_hh_elimina AS ",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM, ",
    "    \t  t1.SECTOR,",
    "\t\t   t1.C_CAGENTE,",
    "\t\t\tt1.C_CUENTA,",
    "\t\t\tt1.C_ENTRADA,\t\t\t",
    "\t\t\tSUM(T1.DATO)*-1 AS DATO,",
    "\t\t\tT1.C_SCN,",
    "           T1.N_SCN,",
    "\t\t   'PS' AS FUENTE,\t",
    "\t\t   '0014f' AS PROC",
    "FROM TABLAS.BD_CTSI t1",
    "   WHERE T1.C_CAGENTE IN('511') AND T1.C_ENTRADA='H' AND T1.C_SCN='AF.5' AND T1.SECTOR=36912",
    "\tGROUP BY T1.MONEDA,t1.'AÑO'n, T1.TRIM,t1.SECTOR,t1.C_CAGENTE,",
    "\t\t     T1.C_CUENTA, t1.C_ENTRADA,T1.C_SCN,",
    "           T1.N_SCN;",
    "QUIT;",
    "",
    "proc datasets;",
    "append base=tablas.bd_ctsi data=pat_36912_hh force;",
    "run;",
    "proc datasets;",
    "append base=tablas.bd_ctsi data=pat_36912_36 force;",
    "run;",
    "proc datasets;",
    "append base=tablas.bd_ctsi data=pat_36912_53 force;",
    "run;",
    "proc datasets;",
    "append base=tablas.bd_ctsi data=pat_36912_hh_elimina force;",
    "run;",
    "",
    "PROC SQL; DROP TABLE pat_36912_hh,pat_36912_36,pat_36912_hh_elimina;QUIT;",
    "",
    "",
    "/*IMPUTA ACTIVO DE HOGARES CON INFO DE CONTRAPARTIDA*/",
    "PROC SQL;",
    "CREATE TABLE WORK.ACTIVO_HH AS ",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM, ",
    "    \t   511 AS SECTOR,",
    "\t\t   LEFT(PUT(T1.SECTOR,CHAR11.)) AS C_CAGENTE,",
    "\t\t\tt1.C_CUENTA,",
    "\t\t\t'D' AS C_ENTRADA,\t\t\t",
    "\t\t\tSUM(T1.DATO) AS DATO,",
    "\t\t\tT1.C_SCN,",
    "           T1.N_SCN,",
    "\t\t   'PS' AS FUENTE,\t",
    "\t\t   '0015' AS PROC",
    "FROM TABLAS.BD_CTSI t1",
    "   WHERE C_CAGENTE IN('5','511','S14') AND C_ENTRADA='H' AND C_CUENTA IN ('Bce Final','Financiera','Bce Inicio','Rec Precio','Rec Precio Reaj','Rec Volumen')",
    "\tGROUP BY T1.MONEDA,t1.'AÑO'n, T1.TRIM,",
    "\t\t     T1.C_CUENTA, T1.C_SCN,",
    "           T1.N_SCN,CALCULATED C_CAGENTE;",
    "QUIT;",
    "PROC SQL; UPDATE ACTIVO_HH SET C_CAGENTE='51022' WHERE C_CAGENTE='5111' AND C_SCN='AF.5';QUIT;",
    "proc datasets;",
    "append base=tablas.bd_ctsi data=WORK.ACTIVO_HH force;",
    "run;",
    "PROC SQL;",
    "DROP TABLE WORK.ACTIVO_HH;",
    "/*IMPUTA PASIVO DE HOGARES CON INFO DE CONTRAPARTIDA*/",
    "PROC SQL;",
    "CREATE TABLE WORK.PASIVO_HH AS ",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM,",
    "    \t   511 AS SECTOR,",
    "\t\t   LEFT(PUT(T1.SECTOR,CHAR11.)) AS C_CAGENTE,",
    "\t\t\tt1.C_CUENTA,",
    "\t\t\t'H' AS C_ENTRADA,\t\t\t",
    "\t\t\tSUM(T1.DATO) AS DATO,",
    "\t\t\tT1.C_SCN,",
    "           T1.N_SCN,",
    "\t\t   'PS' AS FUENTE,\t",
    "\t\t   '0016' AS PROC",
    "FROM TABLAS.BD_CTSI t1",
    "   WHERE C_CAGENTE IN('5','511','S14') AND C_ENTRADA='D' AND C_CUENTA IN ('Bce Final','Financiera','Bce Inicio','Rec Precio','Rec Precio Reaj','Rec Volumen')",
    "\tGROUP BY T1.MONEDA,t1.'AÑO'n, T1.TRIM,",
    "\t\t     T1.C_CUENTA, T1.C_SCN,",
    "           T1.N_SCN,CALCULATED C_CAGENTE;",
    "QUIT;",
    "proc datasets;",
    "append base=tablas.bd_ctsi data=WORK.PASIVO_HH force;",
    "run;",
    "PROC SQL;",
    "DROP TABLE WORK.PASIVO_HH;",
    "/*DEPOSITOS AF29 ENTRE BCOS-PASIVO Y MUNICIPALIDADES-ACTIVO.RESPETA DATO DE SECTOR 321*/",
    "PROC SQL;",
    "CREATE TABLE WORK.AF29_42_321 AS ",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM,",
    "    \t   42 AS SECTOR,",
    "\t\t   '321' AS C_CAGENTE,",
    "\t\t\tt1.C_CUENTA,",
    "\t\t\t'D' AS C_ENTRADA,\t\t\t",
    "\t\t\tSUM(T1.DATO) AS DATO,",
    "\t\t\tT1.C_SCN,",
    "           T1.N_SCN,",
    "\t\t   'PS' AS FUENTE,\t",
    "\t\t   '0142' AS PROC",
    "FROM TABLAS.BD_CTSI t1",
    "   WHERE (t1.SECTOR=321 and T1.C_CAGENTE='42' AND T1.C_ENTRADA='H' AND T1.C_SCN='AF.29')",
    "\tGROUP BY T1.MONEDA,t1.'AÑO'n, T1.TRIM,",
    "\t\t     T1.C_CUENTA,\t",
    "\t          CALCULATED C_ENTRADA, ",
    "\t          t1.C_SCN,T1.N_SCN;",
    "QUIT;",
    "proc datasets;",
    "append base=tablas.bd_ctsi data=WORK.AF29_42_321 force;",
    "run;",
    "PROC SQL;",
    "DROP TABLE WORK.AF29_42_321;",
    "/*AJUSTA TOTAL DE DEPÓSITOS BANCARIOS IMPUTANDO DIF ENTRE ACTIVO Y PASIVO EN EL ACTIVO DEL SECTOR 51022 CON CONTRAGENTE 321*/",
    "PROC SQL;",
    "CREATE TABLE WORK.AF22_TOTAL AS ",
    "   SELECT  'P' AS MONEDA,t1.'AÑO'n, T1.TRIM,",
    "    \t   51022 AS SECTOR,",
    "\t\t   '321' AS C_CAGENTE,",
    "\t\t(CASE WHEN T1.SECTOR=321 AND T1.C_CUENTA='Rec Precio Reaj' THEN 'Rec Precio' ",
    "\t\t      WHEN  T1.SECTOR<>321 AND T1.C_CUENTA IN('Rec Precio Reaj','Rec Volumen') THEN 'Rec Precio' ",
    "              ELSE T1.C_CUENTA END) AS C_CUENTA,",
    "\t\t\t'D' AS C_ENTRADA,\t\t\t",
    "\t\t\tSUM(CASE WHEN T1.C_ENTRADA='D' THEN T1.DATO*-1 ELSE T1.DATO END) AS DATO,",
    "\t\t\tT1.C_SCN,",
    "           'Depósitos' as N_SCN,",
    "\t\t   'PS' AS FUENTE,\t",
    "\t\t   '0118' AS PROC",
    "FROM TABLAS.BD_CTSI t1",
    "   WHERE (T1.C_ENTRADA='D' AND T1.C_SCN='AF.22' AND C_CAGENTE='321') OR (T1.C_ENTRADA='H' AND T1.C_SCN='AF.22' AND SECTOR=321)",
    "\tGROUP BY CALCULATED MONEDA,t1.'AÑO'n, T1.TRIM,",
    "\t\t     CALCULATED C_CUENTA,\t",
    "\t          CALCULATED C_ENTRADA, ",
    "\t          t1.C_SCN;",
    "QUIT;",
    "PROC SQL; /*CIERRE 2020. EL AJUSTE ANTERIOR SE LLEVA A ACTIVO AF29 SECTOR 51022 CA 321 PARA EQUILIBRAR EL BALANCE*/",
    "CREATE TABLE WORK.AF29_aj AS ",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM,",
    "    \t   T1.SECTOR,",
    "\t\t   T1.C_CAGENTE,",
    "\t\t\tT1.C_CUENTA,",
    "\t\t\tT1.C_ENTRADA,\t\t\t",
    "\t\t\tT1.DATO*-1  AS DATO,",
    "\t\t\t'AF.29' AS C_SCN,",
    "           'Otros depósitos' as N_SCN,",
    "\t\t   T1.FUENTE,\t",
    "\t\t   T1.PROC",
    "FROM AF22_TOTAL t1;",
    "QUIT;",
    "proc datasets;",
    "append base=tablas.bd_ctsi data=WORK.AF22_TOTAL force;",
    "run;",
    "proc datasets;",
    "append base=tablas.bd_ctsi data=WORK.AF29_aj force;",
    "run;",
    "PROC SQL;",
    "DROP TABLE WORK.AF22_TOTAL,AF29_aj;",
    "/*AJUSTA TOTAL DE OTROS DEPÓSITOS IMPUTANDO DIF ENTRE ACTIVO Y PASIVO EN EL ACTIVO DEL SECTOR 51022 CON CONTRAGENTE 321*/",
    "PROC SQL;",
    "CREATE TABLE WORK.AF29_TOTAL AS ",
    "   SELECT  'P' AS MONEDA,t1.'AÑO'n, T1.TRIM,",
    "    \t   51022 AS SECTOR,",
    "\t\t   '321' AS C_CAGENTE,",
    "\t\t\tt1.C_CUENTA,",
    "\t\t\t'D' AS C_ENTRADA,\t\t\t",
    "\t\t\tSUM(CASE WHEN T1.C_ENTRADA='D' THEN T1.DATO*-1 ELSE T1.DATO END) AS DATO,",
    "\t\t\tT1.C_SCN,",
    "           T1.N_SCN,",
    "\t\t   'PS' AS FUENTE,\t",
    "\t\t   '0159' AS PROC",
    "FROM TABLAS.BD_CTSI t1",
    "   WHERE (T1.C_ENTRADA='D' AND T1.C_SCN='AF.29') OR (T1.C_ENTRADA='H' AND T1.C_SCN='AF.29')",
    "\tGROUP BY CALCULATED MONEDA,t1.'AÑO'n, T1.TRIM,",
    "\t\t     T1.C_CUENTA,\t",
    "\t          CALCULATED C_ENTRADA, ",
    "\t          t1.C_SCN,t1.N_SCN;",
    "QUIT;",
    "PROC SQL;/*CIERRE 2020. AJUSTE ANTERIOR SE IMPUTA EN ACTIVO AF7 SECTOR 51022 CA 53, PARA EQUILIBRAR BALANCE*/",
    "CREATE TABLE WORK.AF7_AJUSTE AS ",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM,",
    "    \t   T1.SECTOR,",
    "\t\t   '53' AS C_CAGENTE,",
    "\t\t\tt1.C_CUENTA,",
    "\t\t\tT1.C_ENTRADA,\t\t\t",
    "\t\t\tT1.DATO*-1  AS DATO,",
    "\t\t\t'AF.7' AS C_SCN,",
    "           'Créditos comerciales' AS N_SCN,",
    "\t\t   T1.FUENTE,\t",
    "\t\t   T1.PROC",
    "FROM AF29_TOTAL t1;",
    "QUIT;",
    "proc datasets;",
    "append base=tablas.bd_ctsi data=WORK.AF29_TOTAL force;",
    "run;",
    "proc datasets;",
    "append base=tablas.bd_ctsi data=AF7_AJUSTE force;",
    "run;",
    "PROC SQL;",
    "DROP TABLE WORK.AF29_TOTAL,AF7_AJUSTE;QUIT;",
    ""
  ]
}
  "code_lines": [
    "﻿\r",
    "/*DATOS CON CONTRAPARTIDA*/\r",
    "PROC SQL;\r",
    "CREATE TABLE WORK.FINANCIERA_CA AS\r",
    "SELECT T1.AÑO,T1.TRIM,(substr(PUT(t1.'AÑO'n,CHAR4.),3,2) ||\".\"|| PUT(t1.TRIM,CHAR1.)) AS PERIODO,\r",
    "(CASE WHEN T1.C_CUENTA in ('Rec Precio','Rec Precio Reaj') THEN 'Revalorizaciones'\r",
    "\t  WHEN T1.C_CUENTA='Rec Volumen' THEN 'Otros'\r",
    "\t  WHEN T1.C_CUENTA='Bce Final' THEN 'Saldos' ELSE T1.C_CUENTA END) AS C_CUENTA,\r",
    "\tT1.C_ENTRADA,t2.C_SI_SCN,T2.N_SI_SCN,T4.C_SCN_N1,T4.N_SCN_N1,SUM(T1.DATO)/1000 FORMAT COMMA14. AS DATO,\r",
    "\t(CASE WHEN T3.C_SI_SCN='S.99' THEN 'S.11' ELSE T3.C_SI_SCN END) AS C_CAG_N0, \r",
    "\t(CASE WHEN T3.C_SI_SCN='S.99' THEN 'Sociedades no financieras' ELSE T3.N_SI_SCN END) AS N_CAG_N0\r",
    "FROM TABLAS.BD_CTSI T1 \r",
    "LEFT JOIN TABLAS.T_Sectorizacion T2 ON (T1.SECTOR=T2.C_SI) \r",
    "LEFT JOIN TABLAS.T_Instrumentos T4 ON (T1.C_SCN=T4.C_SCN) \r",
    "LEFT JOIN TABLAS.T_Contrapartidas T3 ON (T1.C_CAGENTE=T3.C_CAGENTE) \r",
    "where T1.C_Cuenta in ('Bce Final','Financiera','Rec Precio','Rec Precio Reaj','Rec Volumen')  AND T1.AÑO>2002 \r",
    "GROUP BY T1.AÑO,T1.TRIM,CALCULATED C_CUENTA,T1.C_ENTRADA,t2.C_SI_SCN,T2.N_SI_SCN,T4.C_SCN_N1,T4.N_SCN_N1,CALCULATED C_CAG_N0,CALCULATED N_CAG_N0;\r",
    "QUIT;\r",
    "\r",
    "/*GENERA GRÁFICOS NIVELES SALDOS CON CA*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE BCE_CA AS\r",
    "\t\tSELECT T.PERIODO, T.N_SI_SCN,T.N_SCN_N1,t.C_ENTRADA, T.C_CUENTA,T.DATO,T.C_CAG_N0 AS GRUPO,T.N_CAG_N0 \r",
    "\tFROM WORK.FINANCIERA_CA as T WHERE (T.C_SI_SCN=\"&Sector\" AND T.C_SCN_N1=\"&Codigo\" AND T.C_ENTRADA=\"&Entrada\" AND T.C_CUENTA='Saldos');\r",
    "QUIT;\r",
    "\r",
    "proc sgrender data=BCE_CA template=template_chart1;\r",
    "\tdynamic VAR=\"DATO\" varlabel=\"Dato\" normal=\"yes\"\r",
    "\t\t\t/*VAR2=\"Ahorro\" varlabel=\"Ahorro\" normal=\"yes\"\r",
    "\t\t\tVAR3=\"GRUPO\" varlabel=\"Grupo\" normal=\"yes\"*/\r",
    "\t\t\ttitle=\"SALDOS POR CONTRAPARTIDA\"\r",
    "\t\t\ttitle2=\"SECTOR: &Sector - INSTRUMENTO: &Codigo - ACTIVO/PASIVO: &Entrada\"\r",
    "\t\t\ttitle3=\"(miles de millones de pesos)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "\r",
    "/*GENERA GRÁFICOS NIVELES FINANCIERA CON CA*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE FIN_CA AS\r",
    "\t\tSELECT T.PERIODO, T.N_SI_SCN,T.N_SCN_N1,t.C_ENTRADA, T.C_CUENTA,T.DATO,T.C_CAG_N0 AS GRUPO,T.N_CAG_N0 \r",
    "\tFROM WORK.FINANCIERA_CA as T WHERE (T.C_SI_SCN=\"&Sector\" AND T.C_SCN_N1=\"&Codigo\" AND T.C_ENTRADA=\"&Entrada\" AND T.C_CUENTA='Financiera');\r",
    "QUIT;\r",
    "proc sgrender data=FIN_CA template=template_chart1;\r",
    "\tdynamic VAR=\"DATO\" varlabel=\"Dato\" normal=\"yes\"\r",
    "\t\t\ttitle=\"CUENTA FINANCIERA POR CONTRAPARTIDA\"\r",
    "\t\t\ttitle2=\"SECTOR: &Sector - INSTRUMENTO: &Codigo - ACTIVO/PASIVO: &Entrada\"\r",
    "\t\t\ttitle3=\"(miles de millones de pesos)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "\r",
    "\r",
    "/*GENERA GRÁFICOS NIVELES OTROS CON CA*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE WORK.OTROS_CA AS\r",
    "\t\tSELECT T.PERIODO, T.N_SI_SCN,T.N_SCN_N1,t.C_ENTRADA, SUM(T.DATO) AS DATO,T.C_CAG_N0 AS GRUPO,T.N_CAG_N0 \r",
    "\tFROM WORK.FINANCIERA_CA as T \r",
    "\tWHERE (T.C_SI_SCN=\"&Sector\" AND T.C_SCN_N1=\"&Codigo\" AND T.C_ENTRADA=\"&Entrada\" AND T.C_CUENTA IN ('Revalorizaciones','Otros'))\r",
    "\tGROUP BY T.PERIODO, T.N_SI_SCN,T.N_SCN_N1,t.C_ENTRADA,T.C_CAG_N0,T.N_CAG_N0;\r",
    "QUIT;\r",
    "proc sgrender data=OTROS_CA template=template_chart1;\r",
    "\tdynamic VAR=\"DATO\" varlabel=\"Dato\" normal=\"yes\"\r",
    "\t\t\ttitle=\"OTROS POR CONTRAPARTIDA SECTOR\"\r",
    "\t\t\ttitle2=\"SECTOR: &Sector - INSTRUMENTO: &Codigo - ACTIVO/PASIVO: &Entrada\"\r",
    "\t\t\ttitle3=\"(miles de millones de pesos)\"\r",
    "\t\t\tFOOTNOTE=\"* considera revalorizaciones y volúmenes\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "\r",
    "proc sql; drop table financiera_ca,fon_ca,otros_ca,bce_ca;quit;"
  ]
}
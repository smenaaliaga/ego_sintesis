  "code_lines": [
    "﻿/*COMPRIME TABLA PRINCIPAL*/\r",
    "DATA tablas.BD_CTSI (COMPRESS=YES); SET tablas.BD_CTSI; RUN;\r",
    "/*CAMBIA CONTRAGENTE 511 EN EL PATRIMONIO DE EMPRESAS SUPERVISADAS A 53 PARA RECLACULAR LA PARTE QUE VA A HOGARES EN BASE AL % DEL TOTAL DEL PAT DE EMPRESAS*/\r",
    "PROC SQL; UPDATE TABLAS.BD_CTSI SET C_CAGENTE='53',PROC='0014' WHERE C_CAGENTE='511' AND C_SCN='AF.5' AND C_ENTRADA='H' AND SECTOR=51021;QUIT;\r",
    "/*CIERRE 2020. ELIMINA PASIVO Y ACTIVO AF7 DE EMPRESAS HOGARES CON CONTRAGENTE HOGARES*/\r",
    "PROC SQL; DELETE FROM  TABLAS.BD_CTSI WHERE SECTOR=5111 AND C_SCN='AF.7' AND C_CAGENTE='511';QUIT;\r",
    "\r",
    "/*CIERRE 2021: ELIMINA CONTRAGENTE HOGARES EN PATRIMONIO DE RESTO DE EMPRESAS SECTOR 51022, PORQUE LE GENERA MUCHA VOLATILIDAD AL SECTOR*/\r",
    "PROC SQL; UPDATE TABLAS.BD_CTSI SET C_CAGENTE='53',PROC='0014a' WHERE C_CAGENTE='511' AND C_SCN='AF.5' AND C_ENTRADA='H' AND SECTOR=51022;QUIT;\r",
    "\r",
    "/*CIERRE 2021: EN EMPRESAS HOGARES (SECTOR 5111)DEJA TODO EL PATRIMONIO PARA HOGARES (LO DEJA EN CA 53 PARA QUE LO IMPUTE PORQUE ASÍ ESTABA ANTES*/\r",
    "PROC SQL; UPDATE TABLAS.BD_CTSI SET C_CAGENTE='53',PROC='0014b' WHERE C_SCN='AF.5' AND C_ENTRADA='H' AND SECTOR=5111;QUIT;\r",
    "\r",
    "/*CIERRE 2021: AJUSTA PATRIMONIO DE SECTOR 36912 ASIGNADO A HOGARES EN 1/3 YA QUE ES MUY VOLÁTIL Y DISTORSIONA LA CTA FINANCIERA. LA DIFERENCIA SE LLEVA A CONTRAGENTE 36912 y 53*/\r",
    "PROC SQL;/*calcula patrimonio ajustado a hogares*/\r",
    "CREATE TABLE pat_36912_hh AS /*ajusta patrimonio con hogares*/\r",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM, \r",
    "    \t  t1.SECTOR,\r",
    "\t\t   t1.C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\tt1.C_ENTRADA,\t\t\t\r",
    "\t\t\tSUM(T1.DATO)/3 AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           T1.N_SCN,\r",
    "\t\t   'PS' AS FUENTE,\t\r",
    "\t\t   '0014d' AS PROC\r",
    "FROM TABLAS.BD_CTSI t1\r",
    "   WHERE T1.C_CAGENTE IN('511') AND T1.C_ENTRADA='H' AND T1.C_SCN='AF.5' AND T1.SECTOR=36912\r",
    "\tGROUP BY T1.MONEDA,t1.'AÑO'n, T1.TRIM,t1.SECTOR,t1.C_CAGENTE,\r",
    "\t\t     T1.C_CUENTA, t1.C_ENTRADA,T1.C_SCN,\r",
    "           T1.N_SCN;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "CREATE TABLE pat_36912_36 AS /*deja 1/3 en ca 36912*/\r",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM, \r",
    "    \t  t1.SECTOR,\r",
    "\t\t   '36912' as C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\tt1.C_ENTRADA,\t\t\t\r",
    "\t\t\tSUM(T1.DATO)*1/3 AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           T1.N_SCN,\r",
    "\t\t   'PS' AS FUENTE,\t\r",
    "\t\t   '0014e' AS PROC\r",
    "FROM TABLAS.BD_CTSI t1\r",
    "   WHERE T1.C_CAGENTE IN('511') AND T1.C_ENTRADA='H' AND T1.C_SCN='AF.5' AND T1.SECTOR=36912\r",
    "\tGROUP BY T1.MONEDA,t1.'AÑO'n, T1.TRIM,t1.SECTOR,t1.C_CAGENTE,\r",
    "\t\t     T1.C_CUENTA, t1.C_ENTRADA,T1.C_SCN,\r",
    "           T1.N_SCN;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "CREATE TABLE pat_36912_53 AS /*deja 1/3 en ca 53*/\r",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM, \r",
    "    \t  t1.SECTOR,\r",
    "\t\t   '53' as C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\tt1.C_ENTRADA,\t\t\t\r",
    "\t\t\tSUM(T1.DATO)*1/3 AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           T1.N_SCN,\r",
    "\t\t   'PS' AS FUENTE,\t\r",
    "\t\t   '0014e' AS PROC\r",
    "FROM TABLAS.BD_CTSI t1\r",
    "   WHERE T1.C_CAGENTE IN('511') AND T1.C_ENTRADA='H' AND T1.C_SCN='AF.5' AND T1.SECTOR=36912\r",
    "\tGROUP BY T1.MONEDA,t1.'AÑO'n, T1.TRIM,t1.SECTOR,t1.C_CAGENTE,\r",
    "\t\t     T1.C_CUENTA, t1.C_ENTRADA,T1.C_SCN,\r",
    "           T1.N_SCN;\r",
    "QUIT;\r",
    "PROC SQL;/*elimina patrimonio inicial asignado a hogares*/\r",
    "CREATE TABLE pat_36912_hh_elimina AS \r",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM, \r",
    "    \t  t1.SECTOR,\r",
    "\t\t   t1.C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\tt1.C_ENTRADA,\t\t\t\r",
    "\t\t\tSUM(T1.DATO)*-1 AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           T1.N_SCN,\r",
    "\t\t   'PS' AS FUENTE,\t\r",
    "\t\t   '0014f' AS PROC\r",
    "FROM TABLAS.BD_CTSI t1\r",
    "   WHERE T1.C_CAGENTE IN('511') AND T1.C_ENTRADA='H' AND T1.C_SCN='AF.5' AND T1.SECTOR=36912\r",
    "\tGROUP BY T1.MONEDA,t1.'AÑO'n, T1.TRIM,t1.SECTOR,t1.C_CAGENTE,\r",
    "\t\t     T1.C_CUENTA, t1.C_ENTRADA,T1.C_SCN,\r",
    "           T1.N_SCN;\r",
    "QUIT;\r",
    "\r",
    "proc datasets;\r",
    "append base=tablas.bd_ctsi data=pat_36912_hh force;\r",
    "run;\r",
    "proc datasets;\r",
    "append base=tablas.bd_ctsi data=pat_36912_36 force;\r",
    "run;\r",
    "proc datasets;\r",
    "append base=tablas.bd_ctsi data=pat_36912_53 force;\r",
    "run;\r",
    "proc datasets;\r",
    "append base=tablas.bd_ctsi data=pat_36912_hh_elimina force;\r",
    "run;\r",
    "\r",
    "PROC SQL; DROP TABLE pat_36912_hh,pat_36912_36,pat_36912_hh_elimina;QUIT;\r",
    "\r",
    "\r",
    "/*IMPUTA ACTIVO DE HOGARES CON INFO DE CONTRAPARTIDA*/\r",
    "PROC SQL;\r",
    "CREATE TABLE WORK.ACTIVO_HH AS \r",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM, \r",
    "    \t   511 AS SECTOR,\r",
    "\t\t   LEFT(PUT(T1.SECTOR,CHAR11.)) AS C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\t'D' AS C_ENTRADA,\t\t\t\r",
    "\t\t\tSUM(T1.DATO) AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           T1.N_SCN,\r",
    "\t\t   'PS' AS FUENTE,\t\r",
    "\t\t   '0015' AS PROC\r",
    "FROM TABLAS.BD_CTSI t1\r",
    "   WHERE C_CAGENTE IN('5','511','S14') AND C_ENTRADA='H' AND C_CUENTA IN ('Bce Final','Financiera','Bce Inicio','Rec Precio','Rec Precio Reaj','Rec Volumen')\r",
    "\tGROUP BY T1.MONEDA,t1.'AÑO'n, T1.TRIM,\r",
    "\t\t     T1.C_CUENTA, T1.C_SCN,\r",
    "           T1.N_SCN,CALCULATED C_CAGENTE;\r",
    "QUIT;\r",
    "PROC SQL; UPDATE ACTIVO_HH SET C_CAGENTE='51022' WHERE C_CAGENTE='5111' AND C_SCN='AF.5';QUIT;\r",
    "proc datasets;\r",
    "append base=tablas.bd_ctsi data=WORK.ACTIVO_HH force;\r",
    "run;\r",
    "PROC SQL;\r",
    "DROP TABLE WORK.ACTIVO_HH;\r",
    "/*IMPUTA PASIVO DE HOGARES CON INFO DE CONTRAPARTIDA*/\r",
    "PROC SQL;\r",
    "CREATE TABLE WORK.PASIVO_HH AS \r",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM,\r",
    "    \t   511 AS SECTOR,\r",
    "\t\t   LEFT(PUT(T1.SECTOR,CHAR11.)) AS C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\t'H' AS C_ENTRADA,\t\t\t\r",
    "\t\t\tSUM(T1.DATO) AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           T1.N_SCN,\r",
    "\t\t   'PS' AS FUENTE,\t\r",
    "\t\t   '0016' AS PROC\r",
    "FROM TABLAS.BD_CTSI t1\r",
    "   WHERE C_CAGENTE IN('5','511','S14') AND C_ENTRADA='D' AND C_CUENTA IN ('Bce Final','Financiera','Bce Inicio','Rec Precio','Rec Precio Reaj','Rec Volumen')\r",
    "\tGROUP BY T1.MONEDA,t1.'AÑO'n, T1.TRIM,\r",
    "\t\t     T1.C_CUENTA, T1.C_SCN,\r",
    "           T1.N_SCN,CALCULATED C_CAGENTE;\r",
    "QUIT;\r",
    "proc datasets;\r",
    "append base=tablas.bd_ctsi data=WORK.PASIVO_HH force;\r",
    "run;\r",
    "PROC SQL;\r",
    "DROP TABLE WORK.PASIVO_HH;\r",
    "/*DEPOSITOS AF29 ENTRE BCOS-PASIVO Y MUNICIPALIDADES-ACTIVO.RESPETA DATO DE SECTOR 321*/\r",
    "PROC SQL;\r",
    "CREATE TABLE WORK.AF29_42_321 AS \r",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM,\r",
    "    \t   42 AS SECTOR,\r",
    "\t\t   '321' AS C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\t'D' AS C_ENTRADA,\t\t\t\r",
    "\t\t\tSUM(T1.DATO) AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           T1.N_SCN,\r",
    "\t\t   'PS' AS FUENTE,\t\r",
    "\t\t   '0142' AS PROC\r",
    "FROM TABLAS.BD_CTSI t1\r",
    "   WHERE (t1.SECTOR=321 and T1.C_CAGENTE='42' AND T1.C_ENTRADA='H' AND T1.C_SCN='AF.29')\r",
    "\tGROUP BY T1.MONEDA,t1.'AÑO'n, T1.TRIM,\r",
    "\t\t     T1.C_CUENTA,\t\r",
    "\t          CALCULATED C_ENTRADA, \r",
    "\t          t1.C_SCN,T1.N_SCN;\r",
    "QUIT;\r",
    "proc datasets;\r",
    "append base=tablas.bd_ctsi data=WORK.AF29_42_321 force;\r",
    "run;\r",
    "PROC SQL;\r",
    "DROP TABLE WORK.AF29_42_321;\r",
    "/*AJUSTA TOTAL DE DEPÓSITOS BANCARIOS IMPUTANDO DIF ENTRE ACTIVO Y PASIVO EN EL ACTIVO DEL SECTOR 51022 CON CONTRAGENTE 321*/\r",
    "PROC SQL;\r",
    "CREATE TABLE WORK.AF22_TOTAL AS \r",
    "   SELECT  'P' AS MONEDA,t1.'AÑO'n, T1.TRIM,\r",
    "    \t   51022 AS SECTOR,\r",
    "\t\t   '321' AS C_CAGENTE,\r",
    "\t\t(CASE WHEN T1.SECTOR=321 AND T1.C_CUENTA='Rec Precio Reaj' THEN 'Rec Precio' \r",
    "\t\t      WHEN  T1.SECTOR<>321 AND T1.C_CUENTA IN('Rec Precio Reaj','Rec Volumen') THEN 'Rec Precio' \r",
    "              ELSE T1.C_CUENTA END) AS C_CUENTA,\r",
    "\t\t\t'D' AS C_ENTRADA,\t\t\t\r",
    "\t\t\tSUM(CASE WHEN T1.C_ENTRADA='D' THEN T1.DATO*-1 ELSE T1.DATO END) AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           'Depósitos' as N_SCN,\r",
    "\t\t   'PS' AS FUENTE,\t\r",
    "\t\t   '0118' AS PROC\r",
    "FROM TABLAS.BD_CTSI t1\r",
    "   WHERE (T1.C_ENTRADA='D' AND T1.C_SCN='AF.22' AND C_CAGENTE='321') OR (T1.C_ENTRADA='H' AND T1.C_SCN='AF.22' AND SECTOR=321)\r",
    "\tGROUP BY CALCULATED MONEDA,t1.'AÑO'n, T1.TRIM,\r",
    "\t\t     CALCULATED C_CUENTA,\t\r",
    "\t          CALCULATED C_ENTRADA, \r",
    "\t          t1.C_SCN;\r",
    "QUIT;\r",
    "PROC SQL; /*CIERRE 2020. EL AJUSTE ANTERIOR SE LLEVA A ACTIVO AF29 SECTOR 51022 CA 321 PARA EQUILIBRAR EL BALANCE*/\r",
    "CREATE TABLE WORK.AF29_aj AS \r",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM,\r",
    "    \t   T1.SECTOR,\r",
    "\t\t   T1.C_CAGENTE,\r",
    "\t\t\tT1.C_CUENTA,\r",
    "\t\t\tT1.C_ENTRADA,\t\t\t\r",
    "\t\t\tT1.DATO*-1  AS DATO,\r",
    "\t\t\t'AF.29' AS C_SCN,\r",
    "           'Otros depósitos' as N_SCN,\r",
    "\t\t   T1.FUENTE,\t\r",
    "\t\t   T1.PROC\r",
    "FROM AF22_TOTAL t1;\r",
    "QUIT;\r",
    "proc datasets;\r",
    "append base=tablas.bd_ctsi data=WORK.AF22_TOTAL force;\r",
    "run;\r",
    "proc datasets;\r",
    "append base=tablas.bd_ctsi data=WORK.AF29_aj force;\r",
    "run;\r",
    "PROC SQL;\r",
    "DROP TABLE WORK.AF22_TOTAL,AF29_aj;\r",
    "/*AJUSTA TOTAL DE OTROS DEPÓSITOS IMPUTANDO DIF ENTRE ACTIVO Y PASIVO EN EL ACTIVO DEL SECTOR 51022 CON CONTRAGENTE 321*/\r",
    "PROC SQL;\r",
    "CREATE TABLE WORK.AF29_TOTAL AS \r",
    "   SELECT  'P' AS MONEDA,t1.'AÑO'n, T1.TRIM,\r",
    "    \t   51022 AS SECTOR,\r",
    "\t\t   '321' AS C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\t'D' AS C_ENTRADA,\t\t\t\r",
    "\t\t\tSUM(CASE WHEN T1.C_ENTRADA='D' THEN T1.DATO*-1 ELSE T1.DATO END) AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           T1.N_SCN,\r",
    "\t\t   'PS' AS FUENTE,\t\r",
    "\t\t   '0159' AS PROC\r",
    "FROM TABLAS.BD_CTSI t1\r",
    "   WHERE (T1.C_ENTRADA='D' AND T1.C_SCN='AF.29') OR (T1.C_ENTRADA='H' AND T1.C_SCN='AF.29')\r",
    "\tGROUP BY CALCULATED MONEDA,t1.'AÑO'n, T1.TRIM,\r",
    "\t\t     T1.C_CUENTA,\t\r",
    "\t          CALCULATED C_ENTRADA, \r",
    "\t          t1.C_SCN,t1.N_SCN;\r",
    "QUIT;\r",
    "PROC SQL;/*CIERRE 2020. AJUSTE ANTERIOR SE IMPUTA EN ACTIVO AF7 SECTOR 51022 CA 53, PARA EQUILIBRAR BALANCE*/\r",
    "CREATE TABLE WORK.AF7_AJUSTE AS \r",
    "   SELECT  T1.MONEDA,t1.'AÑO'n, T1.TRIM,\r",
    "    \t   T1.SECTOR,\r",
    "\t\t   '53' AS C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\tT1.C_ENTRADA,\t\t\t\r",
    "\t\t\tT1.DATO*-1  AS DATO,\r",
    "\t\t\t'AF.7' AS C_SCN,\r",
    "           'Créditos comerciales' AS N_SCN,\r",
    "\t\t   T1.FUENTE,\t\r",
    "\t\t   T1.PROC\r",
    "FROM AF29_TOTAL t1;\r",
    "QUIT;\r",
    "proc datasets;\r",
    "append base=tablas.bd_ctsi data=WORK.AF29_TOTAL force;\r",
    "run;\r",
    "proc datasets;\r",
    "append base=tablas.bd_ctsi data=AF7_AJUSTE force;\r",
    "run;\r",
    "PROC SQL;\r",
    "DROP TABLE WORK.AF29_TOTAL,AF7_AJUSTE;QUIT;\r",
    ""
  ]
}
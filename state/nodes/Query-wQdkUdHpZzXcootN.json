  "code_lines": [
    "PROC SQL;",
    "   CREATE TABLE WORK.QUERY_FOR_SALIDA_WTW_0000 AS",
    "   SELECT t1.MONEDA,",
    "          t1.'AÑO'n,",
    "          t1.TRIM,",
    "          t1.SECTOR,",
    "          t1.N_SI,",
    "          t1.C_SI_publ,",
    "          t1.N_SI_publ,",
    "          t1.C_SI_SCN,",
    "          t1.N_SI_SCN,",
    "          t1.C_INSTRUMENTO_SCN,",
    "          t1.N_INSTRUMENTO_SCN,",
    "          t1.C_SI_C_AGENTE,",
    "          t1.N_SI_C_AGENTE,",
    "          t1.C_SI_publ_C_AGENTE,",
    "          t1.N_SI_publ_C_AGENTE,",
    "          t1.C_SI_SCN_C_AGENTE,",
    "          t1.N_SI_SCN_C_AGENTE,",
    "          t1.C_CUENTA,",
    "          t1.C_ENTRADA,",
    "          /* DATO */",
    "            (SUM(t1.DATO)) AS DATO,",
    "          t1.C_SI_SCN_N1,",
    "          t1.N_SI_SCN_N1,",
    "          t1.C_INSTRUMENTO_SCN_N1,",
    "          t1.N_INSTRUMENTO_SCN_N1,",
    "          t1.C_Cuenta_SCN,",
    "          t1.N_Cuenta_SCN,",
    "          t1.C_SCN_N0,",
    "          t1.N_SCN_N0,",
    "          t1.C_CAG_N0,",
    "          t1.N_CAG_N0",
    "      FROM WORK.SALIDA_WTW t1",
    "      WHERE t1.C_SI_SCN = 'S.13'",
    "      GROUP BY t1.MONEDA,",
    "               t1.'AÑO'n,",
    "               t1.TRIM,",
    "               t1.SECTOR,",
    "               t1.N_SI,",
    "               t1.C_SI_publ,",
    "               t1.N_SI_publ,",
    "               t1.C_SI_SCN,",
    "               t1.N_SI_SCN,",
    "               t1.C_INSTRUMENTO_SCN,",
    "               t1.N_INSTRUMENTO_SCN,",
    "               t1.C_SI_C_AGENTE,",
    "               t1.N_SI_C_AGENTE,",
    "               t1.C_SI_publ_C_AGENTE,",
    "               t1.N_SI_publ_C_AGENTE,",
    "               t1.C_SI_SCN_C_AGENTE,",
    "               t1.N_SI_SCN_C_AGENTE,",
    "               t1.C_CUENTA,",
    "               t1.C_ENTRADA,",
    "               t1.C_SI_SCN_N1,",
    "               t1.N_SI_SCN_N1,",
    "               t1.C_INSTRUMENTO_SCN_N1,",
    "               t1.N_INSTRUMENTO_SCN_N1,",
    "               t1.C_Cuenta_SCN,",
    "               t1.N_Cuenta_SCN,",
    "               t1.C_SCN_N0,",
    "               t1.N_SCN_N0,",
    "               t1.C_CAG_N0,",
    "               t1.N_CAG_N0;",
    "QUIT;"
  ]
}
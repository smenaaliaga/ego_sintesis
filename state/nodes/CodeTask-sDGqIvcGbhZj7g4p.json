  "code_lines": [
    "﻿/*JUNTA DATOS DE SECTORES*/\r",
    "\r",
    "data bd_sectores; set cnf_anual;drop dato;if c_cuenta='Capital';Sector='S.11'; run;\r",
    "\r",
    "data gob;set CNF_G_ANUAL;drop dato;if c_cuenta='Capital' or c_scn='B.8';Sector='S.13'; run;\r",
    "\r",
    "data fin;set CNF_SF_ANUAL;drop dato;if c_cuenta='Capital' or c_scn='B.8';Sector='S.12'; run;\r",
    "\r",
    "data bd_sectores; set bd_sectores gob fin;run;\r",
    "\r",
    "proc sql; drop table gob,fin;quit;\r",
    "\r",
    "\r",
    "/*III. CREA CNF ANUALIZADA DE HOGARES*/\r",
    "/*CREA PIB ANUALIZADO*/\r",
    "PROC SQL;\r",
    "CREATE TABLE CNF_ANUAL_HH AS\r",
    "SELECT T3.AÑO_ACUM,T3.TRIM_ACUM,(substr(PUT(t3.AÑO_ACUM,CHAR4.),3,2) ||\".\"|| PUT(t3.TRIM_ACUM,CHAR1.)) AS PERIODO,T1.C_CUENTA,T1.C_SCN,T1.N_SCN_N1,\r",
    "\tSUM(T1.DATO/T4.DATO)*100 FORMAT COMMA14.1 AS RATIO, 'S.14' as Sector\r",
    "FROM CNF_HH T1 \r",
    "LEFT JOIN TABLAS.TIEMPO T3 ON (T1.AÑO=T3.AÑO AND T1.TRIM=T3.TRIM)\r",
    "LEFT JOIN WORK.PIB_ACUM T4 ON (T4.AÑO=T3.AÑO_ACUM AND T4.TRIM=T3.TRIM_ACUM)\r",
    "LEFT JOIN T_MAX T5 ON (T4.AÑO=T5.AÑO AND T4.TRIM=T5.TRIM)\r",
    "WHERE T4.DATO<>. AND T5.ID<>. and (T1.C_CUENTA='Capital' or t1.c_scn in ('B.8'))\r",
    "GROUP BY T3.AÑO_ACUM,T3.TRIM_ACUM,T1.C_CUENTA,T1.C_SCN,T1.N_SCN_N1;\r",
    "QUIT;\r",
    "\r",
    "data bd_sectores;set bd_sectores CNF_ANUAL_HH;run;\r",
    "proc sql; update bd_sectores set n_scn_n1='Formación bruta de capital' where c_scn in ('K.21','D.9','P.51','P.52');quit;\r",
    "\r",
    "proc sql; drop table CNF_ANUAL_HH;quit;\r",
    "\r",
    "\r",
    "/*CREA GRÁFICO DE BARRAS PARA CUENTA DE CAPITAL COMO % PIB*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE CTA_K_G AS\r",
    "\t\tSELECT T.PERIODO, SUM(T.RATIO) AS RATIO , T.N_SCN_N1\r",
    "\tFROM bd_sectores as T\r",
    "\tWHERE  (T.C_CUENTA='Capital' or T.C_SCN='B.8')  AND T.C_SCN NOT IN ('B.9')\r",
    "\tGROUP BY T.PERIODO,T.N_SCN_N1;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "\tCREATE TABLE CTA_K_C AS\r",
    "\t\tSELECT T.PERIODO, T.RATIO FORMAT COMMA20.1, SUM(T.RATIO) FORMAT COMMA20.1 LABEL \"Préstamo neto\" AS PN , T.N_SCN_N1 AS GRUPO\r",
    "\tFROM CTA_K_G as T\r",
    "\tGROUP BY T.PERIODO\r",
    "\t\tORDER BY T.PERIODO,T.N_SCN_N1;\r",
    "QUIT;\r",
    "%_sas_pushchartsize(600,500);\r",
    "\r",
    "proc sgrender data=CTA_K_C template=template_chart1;\r",
    "\tdynamic VAR=\"RATIO\" varlabel=\"Ratio\" normal=\"yes\"\r",
    "\t\t\tVAR2=\"PN\" varlabel=\"PN\" normal=\"yes\"\r",
    "\t\t\tVAR3=\"GRUPO\" varlabel=\"Grupo\" normal=\"yes\"\r",
    "\t\t\ttitle=\"COMPONENTES DEL PTMO NETO NO FINANCIERO DE LA ECONOMÍA NACIONAL\"\r",
    "\t\t\ttitle2=\"(porcentaje del PIB)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "PROC SQL; DROP TABLE CTA_K_C,CTA_K_G;QUIT;\r",
    "\r",
    "/*CREA GRÁFICO DE BARRAS PARA FBCF POR COMPONENTE*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE FBCF_G AS\r",
    "\t\tSELECT T.PERIODO, SUM(T.RATIO)*-1 as RATIO , T.C_SCN\r",
    "\tFROM bd_sectores as T\r",
    "\tWHERE  T.N_SCN_N1 in ('Formación bruta de capital')\r",
    "\tGROUP BY T.PERIODO,T.C_SCN;  \r",
    "QUIT;\r",
    "PROC SQL;\r",
    "\tCREATE TABLE FBCF_C AS\r",
    "\t\tSELECT T.PERIODO, T.RATIO FORMAT COMMA20.1,SUM(T.RATIO) FORMAT COMMA20.1 LABEL \"FBC nacional\" as FBC , T.C_SCN AS GRUPO\r",
    "\tFROM FBCF_G as T\r",
    "\tGROUP BY T.PERIODO\r",
    "\tORDER BY T.PERIODO,T.C_SCN;  \r",
    "QUIT;\r",
    "proc sgrender data=FBCF_C template=template_chart1;\r",
    "\tdynamic VAR=\"RATIO\" varlabel=\"Ratio\" normal=\"yes\"\r",
    "\t\t\tVAR2=\"FBC\" varlabel=\"PN\" normal=\"yes\"\r",
    "\t\t\tVAR3=\"GRUPO\" varlabel=\"Grupo\" normal=\"yes\"\r",
    "\t\t\ttitle=\"FBC POR SECTOR COMPONENTE\"\r",
    "\t\t\ttitle2=\"(porcentaje del PIB)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "PROC SQL; DROP TABLE FBCF_C,FBCF_G;QUIT;\r",
    "\r",
    "/*CREA GRÁFICO DE BARRAS PARA AHORRO POR SECTOR INSTITUCIONAL*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE AH_NAC AS\r",
    "\t\tSELECT T.PERIODO, SUM(T.RATIO) AS RATIO , T.SECTOR\r",
    "\tFROM bd_sectores as T\r",
    "\tWHERE  T.C_SCN='B.8'\r",
    "\tGROUP BY T.PERIODO,T.SECTOR;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "\tCREATE TABLE AH_NAC_C AS\r",
    "\t\tSELECT T.PERIODO, T.RATIO FORMAT COMMA20.1,SUM(T.RATIO) FORMAT COMMA20.1 LABEL \"Ahorro\" AS AHORRO , T.SECTOR AS GRUPO\r",
    "\tFROM AH_NAC as T\r",
    "\tGROUP BY T.PERIODO\r",
    "\tORDER BY T.PERIODO,T.SECTOR;\r",
    "QUIT;\r",
    "proc sgrender data=AH_NAC_C template=template_chart1;\r",
    "\tdynamic VAR=\"RATIO\" varlabel=\"Ratio\" normal=\"yes\"\r",
    "\t\t\tVAR2=\"AHORRO\" varlabel=\"AHORRO\" normal=\"yes\"\r",
    "\t\t\tVAR3=\"GRUPO\" varlabel=\"Grupo\" normal=\"yes\"\r",
    "\t\t\ttitle=\"AHORRO NACIONAL POR SECTOR INSTITUCIONAL\"\r",
    "\t\t\ttitle2=\"(porcentaje del PIB)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "PROC SQL; DROP TABLE AH_NAC_C,AH_NAC;QUIT;\r",
    "\r",
    "/*CREA GRÁFICO DE BARRAS PARA FBCF POR SECTOR INSTITUCIONAL*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE FBC_SECTOR AS\r",
    "\t\tSELECT T.PERIODO, SUM(T.RATIO)*-1 as RATIO , T.SECTOR\r",
    "\tFROM bd_sectores as T\r",
    "\tWHERE  T.C_SCN in ('K.21','D.9','P.51','P.52')\r",
    "\tGROUP BY T.PERIODO,T.SECTOR;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "\tCREATE TABLE FBC_SECTOR_C AS\r",
    "\t\tSELECT T.PERIODO, T.RATIO FORMAT COMMA20.1,SUM(T.RATIO) FORMAT COMMA20.1 LABEL \"FBC\" as fbc , T.SECTOR AS GRUPO\r",
    "\tFROM FBC_SECTOR as T\r",
    "\tGROUP BY T.PERIODO\r",
    "\tORDER BY T.PERIODO,T.SECTOR;\r",
    "QUIT;\r",
    "proc sgrender data=FBC_SECTOR_C template=template_chart1;\r",
    "\tdynamic VAR=\"RATIO\" varlabel=\"Ratio\" normal=\"yes\"\r",
    "\t\t\tVAR2=\"FBC\" varlabel=\"FBC\" normal=\"yes\"\r",
    "\t\t\tVAR3=\"GRUPO\" varlabel=\"Grupo\" normal=\"yes\"\r",
    "\t\t\ttitle=\"FBC NACIONAL POR SECTOR INSTITUCIONAL\"\r",
    "\t\t\ttitle2=\"(porcentaje del PIB)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "PROC SQL; DROP TABLE FBC_SECTOR_C,FBC_SECTOR;QUIT;\r",
    "\r",
    "/*CREA GRÁFICO DE BARRAS PARA PTMO NETO POR SECTOR INSTITUCIONAL*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE PN_SECTOR AS\r",
    "\t\tSELECT T.PERIODO, SUM(T.RATIO) AS RATIO , T.SECTOR\r",
    "\tFROM bd_sectores as T\r",
    "\tWHERE  T.C_SCN='B.9'\r",
    "\tGROUP BY T.PERIODO, T.SECTOR;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "\tCREATE TABLE PN_SECTOR_C AS\r",
    "\t\tSELECT T.PERIODO, T.RATIO FORMAT COMMA20.1,SUM(T.RATIO) FORMAT COMMA20.1 LABEL \"Préstamo neto\" AS PN , T.SECTOR AS GRUPO\r",
    "\tFROM PN_SECTOR as T\r",
    "\tGROUP BY T.PERIODO\r",
    "\tORDER BY T.PERIODO, T.SECTOR;\r",
    "QUIT;\r",
    "proc sgrender data=PN_SECTOR_C template=template_chart1;\r",
    "\tdynamic VAR=\"RATIO\" varlabel=\"Ratio\" normal=\"yes\"\r",
    "\t\t\tVAR2=\"PN\" varlabel=\"FBC\" normal=\"yes\"\r",
    "\t\t\tVAR3=\"GRUPO\" varlabel=\"Grupo\" normal=\"yes\"\r",
    "\t\t\ttitle=\"PTMO NETO NACIONAL POR SECTOR INSTITUCIONAL\"\r",
    "\t\t\ttitle2=\"(porcentaje del PIB)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "PROC SQL; DROP TABLE PN_SECTOR_C,PN_SECTOR;QUIT;\r",
    "\r",
    "\r",
    "/*POSICION FINANCIERA NETA DE LOS SECTORES*/\r",
    "\r",
    "proc sql; create table pn_snf as \r",
    "\tselect periodo, 'S.11' as sector, 'B.90' as C_SCN, sum(dato) as dato\r",
    "\tfrom PFN_SNF_PIB\r",
    "\tgroup by periodo;\r",
    "quit;\r",
    "\r",
    "proc sql; create table pn_hh as \r",
    "\tselect periodo, 'S.14' as sector, 'B.90' as C_SCN, sum(dato) as dato\r",
    "\tfrom RFN_PIB\r",
    "\tgroup by periodo;\r",
    "quit;\r",
    "\r",
    "proc sql; create table pn_gg as \r",
    "\tselect periodo, 'S.13' as sector, 'B.90' as C_SCN, sum(dato) as dato\r",
    "\tfrom RFN_PIB_gob\r",
    "\tgroup by periodo;\r",
    "quit;\r",
    "\r",
    "proc sql; create table pn_sf as \r",
    "\tselect periodo, 'S.12' as sector, 'B.90' as C_SCN, sum(dato) as dato\r",
    "\tfrom RFN_PIB_sf\r",
    "\tgroup by periodo;\r",
    "quit;\r",
    "\r",
    "data pn_sectores; set pn_snf pn_hh pn_gg pn_sf;run;\r",
    "proc sql; drop table pn_snf, pn_hh, pn_gg, pn_sf;quit;\r",
    "\r",
    "/*CREA GRÁFICO DE BARRAS PARA POSICION NETA POR SECTOR INSTITUCIONAL*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE PNF_SECTOR_C AS\r",
    "\t\tSELECT T.PERIODO, T.DATO FORMAT COMMA20.1 as RATIO, T.SECTOR as grupo,SUM(T.DATO) FORMAT COMMA20.1 LABEL \"Posición neta\" AS PFN\r",
    "\tFROM pn_sectores as T\r",
    "\tGROUP BY T.PERIODO\r",
    "order by t.periodo,t.sector;\r",
    "QUIT;\r",
    "proc sgrender data=PNF_SECTOR_C template=template_chart1;\r",
    "\tdynamic VAR=\"RATIO\" varlabel=\"Ratio\" normal=\"yes\"\r",
    "\t\t\tVAR2=\"pfn\" varlabel=\"pfn\" normal=\"yes\"\r",
    "\t\t\tVAR3=\"GRUPO\" varlabel=\"Grupo\" normal=\"yes\"\r",
    "\t\t\ttitle=\"POSICIÓN NETA POR SECTOR INSTITUCIONAL\"\r",
    "\t\t\ttitle2=\"(porcentaje del PIB)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "PROC SQL; DROP TABLE PNF_SECTOR_C;quit;\r",
    "\r",
    "proc datasets lib=work;\r",
    "\tdelete _doctmp:;\r",
    "run;\r",
    "quit;\r",
    ""
  ]
}
  "code_lines": [
    "﻿/*CREA BASE CON INFO DEUDA DEL SF*/\r",
    "PROC SQL;\r",
    "CREATE TABLE WORK.DEUDA_SF_SubS AS\r",
    "SELECT T1.AÑO,T1.TRIM,(substr(PUT(t1.'AÑO'n,CHAR4.),3,2) ||\".\"|| PUT(t1.TRIM,CHAR1.)) AS PERIODO,T1.SECTOR,\r",
    "\tT1.C_ENTRADA,T4.C_SCN_N0,T4.N_SCN_N0,T2.C_SI_SCN as C_Sector_pub,T2.N_SI_SCN as N_Sector_pub,T3.N_SI AS N_SI_C_AGENTE,T3.C_SI AS C_SI_C_AGENTE,T3.C_SI_PUBL,\r",
    "\tSUM(T1.DATO)/1000 FORMAT COMMA14. AS DATO\r",
    "FROM TABLAS.BD_CTSI T1 \r",
    "LEFT JOIN TABLAS.T_Sectorizacion T2 ON (T1.SECTOR=T2.C_SI) \r",
    "LEFT JOIN TABLAS.T_Instrumentos T4 ON (T1.C_SCN=T4.C_SCN) \r",
    "LEFT JOIN TABLAS.T_Contrapartidas T3 ON (T1.C_CAGENTE=T3.C_CAGENTE) \r",
    "where T1.C_Cuenta=('Bce Final')  AND T1.AÑO>2002 AND T1.C_SCN IN ('AF.21','AF.22','AF.29','AF.31','AF.32','AF.321','AF.41','AF.42') AND T1.C_ENTRADA='H' AND T2.C_SI_SCN_N1='S.12'\r",
    "GROUP BY T1.AÑO,T1.TRIM,T1.SECTOR,T1.C_ENTRADA,T2.C_SI_SCN,T2.N_SI_SCN,T3.N_SI,T3.C_SI,T3.C_SI_PUBL,T4.C_SCN_N0,T4.N_SCN_N0;\r",
    "QUIT;\r",
    "\r",
    "\r",
    "/*CREA BASE CON INFO RIQUEZA FINANCIERA*/\r",
    "PROC SQL;\r",
    "CREATE TABLE WORK.RFN_SF_SubS AS\r",
    "SELECT T1.AÑO,T1.TRIM,(substr(PUT(t1.'AÑO'n,CHAR4.),3,2) ||\".\"|| PUT(t1.TRIM,CHAR1.)) AS PERIODO,T2.C_SI_SCN as C_Sector_pub,T2.N_SI_SCN as N_Sector_pub,\r",
    "\tT4.C_SCN_N1,T4.N_SCN_N1,T4.C_SCN_N0,T4.N_SCN_N0,T3.C_SI_SCN AS N_SI_C_AGENTE,T3.N_SI_SCN AS C_SI_C_AGENTE,\r",
    "\t(CASE WHEN T4.C_SCN_N1 CONTAINS 'AF.52' THEN 'Cuotas de fondos'\r",
    "\t\t WHEN T4.C_SCN_N1 IN ('AF.612') THEN 'Fondos de pensiones' ELSE T4.N_SCN_N0 END) AS N_SCN_N2,\r",
    "\t\t \tT1.C_ENTRADA,\r",
    "\tSUM(CASE WHEN T1.C_ENTRADA='H' THEN T1.DATO*-1 ELSE T1.DATO END)/1000 FORMAT COMMA14. AS DATO\r",
    "FROM TABLAS.BD_CTSI T1 \r",
    "LEFT JOIN TABLAS.T_Sectorizacion T2 ON (T1.SECTOR=T2.C_SI) \r",
    "LEFT JOIN TABLAS.T_Instrumentos T4 ON (T1.C_SCN=T4.C_SCN) \r",
    "LEFT JOIN TABLAS.T_Contrapartidas T3 ON (T1.C_CAGENTE=T3.C_CAGENTE) \r",
    "where T1.C_Cuenta=('Bce Final')  AND T1.AÑO>2002 AND T1.C_SCN <>('B.90')  AND T2.C_SI_SCN_N1='S.12'\r",
    "GROUP BY T1.AÑO,T1.TRIM,T4.C_SCN_N1,T4.N_SCN_N1,T3.C_SI_SCN,T3.N_SI_SCN,T4.C_SCN_N0,T4.N_SCN_N0,T1.C_ENTRADA,T2.C_SI_SCN,T2.N_SI_SCN;\r",
    "QUIT;\r",
    "\r",
    "\r",
    "/*CREA BASE CON INFO RFN SOBRE PIB*/\r",
    "PROC SQL;\r",
    "CREATE TABLE WORK.RFN_PIB_SF_SubS AS\r",
    "SELECT T1.AÑO,T1.TRIM,T1.PERIODO,t1.C_Sector_pub,t1.N_Sector_pub,T1.C_ENTRADA,T1.C_SCN_N1,T1.N_SCN_N1,T1.C_SCN_N0,T1.N_SCN_N0,t1.N_SCN_N2,\r",
    "     SUM((T1.DATO/T2.DATO)*100) FORMAT COMMA14.1 AS DATO\r",
    "FROM WORK.RFN_SF_SubS T1, WORK.PIB_ACUM T2 WHERE T1.AÑO=T2.AÑO AND T1.TRIM=T2.TRIM\r",
    "GROUP BY T1.AÑO,T1.TRIM,T1.PERIODO,T1.C_SCN_N1,T1.N_SCN_N1,T1.C_SCN_N0,T1.N_SCN_N0,t1.N_SCN_N2,\tT1.C_ENTRADA,t1.C_Sector_pub,t1.N_Sector_pub;\r",
    "QUIT;\r",
    "\r",
    "/*GRAFICO RIQUEZA FINANCIERA NETA POR Subsector*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE RFN_PIB_SF_SubS_C AS\r",
    "\t\tSELECT T.PERIODO, SUM(T.DATO) AS RATIO, T.C_Sector_pub\r",
    "\tFROM WORK.RFN_PIB_SF_SubS as T\r",
    "\tGROUP BY T.PERIODO,T.C_Sector_pub;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "\tCREATE TABLE RFN_PIB_SF_SubS_C1 AS\r",
    "\t\tSELECT T.PERIODO, T.C_Sector_pub AS GRUPO,T.RATIO FORMAT COMMA20.1, SUM(T.RATIO) FORMAT COMMA20.1 LABEL \"Posición neta\" AS PFN\r",
    "\tFROM WORK.RFN_PIB_SF_SubS_C as T\r",
    "\tGROUP BY T.PERIODO\r",
    "\tORDER BY T.PERIODO,T.C_Sector_pub;\r",
    "QUIT;\r",
    "proc sgrender data=RFN_PIB_SF_SubS_C1 template=template_chart1;\r",
    "\tdynamic VAR=\"RATIO\" varlabel=\"Ratio\" normal=\"yes\"\r",
    "\t\t\tVAR2=\"PFN\" varlabel=\"PFN\" normal=\"yes\"\r",
    "\t\t\tVAR3=\"GRUPO\" varlabel=\"Grupo\" normal=\"yes\"\r",
    "\t\t\ttitle=\"POSICIÓN FINANCIERA NETA POR SUB-SECTOR\"\r",
    "\t\t\ttitle2=\"(porcentaje del PIB)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "PROC SQL; DROP TABLE RFN_PIB_SF_SubS_C1,RFN_PIB_SF_SubS_C;QUIT;\r",
    "\r",
    "/*GRAFICO ACTIVOS FINANCIEROSS POR COMPONENTES*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE RFN_PIB_SF_SubS_C3 AS\r",
    "\t\tSELECT T.PERIODO, SUM(T.DATO) AS RATIO, T.C_Sector_pub\r",
    "\tFROM WORK.RFN_PIB_SF_SubS as T\r",
    "\tWHERE T.C_ENTRADA='D'\r",
    "\tGROUP BY T.PERIODO,T.C_Sector_pub;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "\tCREATE TABLE RFN_PIB_SF_SubS_C4 AS\r",
    "\t\tSELECT T.PERIODO, T.C_Sector_pub AS GRUPO,T.RATIO FORMAT COMMA20.1,SUM(T.RATIO) FORMAT COMMA20.1 LABEL \"Activos financieros\" AS Activos\r",
    "\tFROM WORK.RFN_PIB_SF_SubS_C3 as T\r",
    "\tGROUP BY T.PERIODO\r",
    "\tORDER BY T.PERIODO,T.C_Sector_pub;\r",
    "QUIT;\r",
    "proc sgrender data=RFN_PIB_SF_SubS_C4 template=template_chart1;\r",
    "\tdynamic VAR=\"RATIO\" varlabel=\"Ratio\" normal=\"yes\"\r",
    "\t\t\tVAR2=\"Activos\" varlabel=\"Activos\" normal=\"yes\"\r",
    "\t\t\tVAR3=\"GRUPO\" varlabel=\"Grupo\" normal=\"yes\"\r",
    "\t\t\ttitle=\"ACTIVOS FINANCIEROS POR SUB-SECTOR\"\r",
    "\t\t\ttitle2=\"(porcentaje del PIB)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "PROC SQL; DROP TABLE RFN_PIB_SF_SubS_C4,RFN_PIB_SF_SubS_C3;QUIT;\r",
    "\r",
    "\r",
    "/*GRAFICO PASIVOS FINANCIEROSS POR COMPONENTES*/\r",
    "PROC SQL;\r",
    "\tCREATE table PAS_PIB_SF_SubS AS\r",
    "\t\tSELECT T.PERIODO, SUM(T.DATO)*-1 AS RATIO, T.C_Sector_pub\r",
    "\tFROM WORK.RFN_PIB_SF_SubS as T\r",
    "\tWHERE T.C_ENTRADA='H'\r",
    "\tGROUP BY T.PERIODO,T.C_Sector_pub;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "\tCREATE table PAS_PIB_SF_SubS2 AS\r",
    "\t\tSELECT T.PERIODO, T.RATIO FORMAT COMMA20.1,SUM(T.RATIO) FORMAT COMMA20.1 LABEL \"Pasivos\" AS PF, T.C_Sector_pub AS GRUPO\r",
    "\tFROM WORK.PAS_PIB_SF_SubS as T\r",
    "\tGROUP BY T.PERIODO\r",
    "\tORDER BY T.PERIODO,T.C_Sector_pub;\r",
    "QUIT;\r",
    "proc sgrender data=PAS_PIB_SF_SubS2 template=template_chart1;\r",
    "\tdynamic VAR=\"RATIO\" varlabel=\"Ratio\" normal=\"yes\"\r",
    "\t\t\tVAR2=\"PF\" varlabel=\"PF\" normal=\"yes\"\r",
    "\t\t\tVAR3=\"GRUPO\" varlabel=\"Grupo\" normal=\"yes\"\r",
    "\t\t\ttitle=\"PASIVOS FINANCIEROS POR SUB-SECTOR\"\r",
    "\t\t\ttitle2=\"(porcentaje del PIB)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "PROC SQL; DROP TABLE PAS_PIB_SF_SubS2,PAS_PIB_SF_SubS;QUIT;\r",
    "\r",
    "/*DATA PARA CAPACIDAD DE FINANCIAMIENTO */\r",
    "PROC SQL; /*CF ACUMULADA Y A PIB*/\r",
    "CREATE TABLE CF_PIB_SF_SubS AS\r",
    "SELECT T5.AÑO_ACUM AS AÑO,T5.TRIM_ACUM AS TRIM,(substr(PUT(t5.AÑO_ACUM,CHAR4.),3,2) ||\".\"|| PUT(t5.TRIM_acum,CHAR1.)) AS PERIODO,T1.C_ENTRADA,T2.C_SI_SCN as C_Sector_pub,T2.N_SI_SCN as N_Sector_pub,\r",
    "\tT4.C_SCN_N1,T4.N_SCN_N1,T4.C_SCN_N0,T4.N_SCN_N0,T3.C_SI_SCN AS N_SI_C_AGENTE,T3.N_SI_SCN AS C_SI_C_AGENTE,\r",
    "\t(CASE WHEN T4.C_SCN_N1 CONTAINS 'AF.52' THEN 'Cuotas de fondos'\r",
    "\t\t WHEN T4.C_SCN_N1 IN ('AF.612') THEN 'Fondos de pensiones' ELSE T4.N_SCN_N0 END) AS N_SCN_N2,\r",
    "\tSUM(CASE WHEN T1.C_ENTRADA='H' THEN T1.DATO*-1 ELSE T1.DATO END)/1000 FORMAT COMMA14. AS DATO,\r",
    "\tSUM(((CASE WHEN T1.C_ENTRADA='H' THEN T1.DATO*-1 ELSE T1.DATO END)/1000)/t6.dato)*100 FORMAT COMMA14.1 AS RATIO\r",
    "FROM TABLAS.BD_CTSI T1 \r",
    "\tLEFT JOIN TABLAS.T_Sectorizacion T2 ON (T1.SECTOR=T2.C_SI) \r",
    "\tLEFT JOIN TABLAS.T_Instrumentos T4 ON (T1.C_SCN=T4.C_SCN) \r",
    "\tLEFT JOIN TABLAS.T_Contrapartidas T3 ON (T1.C_CAGENTE=T3.C_CAGENTE)\r",
    "\tLEFT JOIN TABLAS.TIEMPO T5 ON (T1.AÑO=T5.AÑO AND T1.TRIM=T5.TRIM)\r",
    " \tLEFT JOIN WORK.PIB_ACUM T6 ON (T5.AÑO_ACUM=T6.AÑO AND T5.TRIM_ACUM=T6.TRIM)\r",
    "\tLEFT JOIN T_MAX T7 ON (T7.AÑO=T6.AÑO AND T7.TRIM=T6.TRIM)\r",
    "where T1.C_Cuenta=('Financiera')  AND T1.AÑO>2002 AND T1.C_SCN <>('B.9')  AND T2.C_SI_SCN_N1='S.12' AND ID<>.\r",
    "GROUP BY AÑO_ACUM,T5.TRIM_ACUM,T4.C_SCN_N1,T4.N_SCN_N1,T4.C_SCN_N0,T4.N_SCN_N0, T3.C_SI_SCN,T3.N_SI_SCN,T1.C_ENTRADA,T2.C_SI_SCN,T2.N_SI_SCN;\r",
    "QUIT;\r",
    "PROC SQL; DELETE FROM CF_PIB_SF WHERE RATIO=.;QUIT;\r",
    "\r",
    "\t/*GRAFICO PTMO NETO POR COMPONENTES*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE PN_SF_SubS AS\r",
    "\t\tSELECT T.PERIODO, SUM(T.RATIO) AS RATIO, T.C_Sector_pub\r",
    "\tFROM CF_PIB_SF_SubS as T\r",
    "\tgroup by T.PERIODO,T.C_Sector_pub;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "\tCREATE TABLE PN_SF_SubS2 AS\r",
    "\t\tSELECT T.PERIODO, T.RATIO FORMAT COMMA20.1,SUM(T.RATIO) FORMAT COMMA20.1 LABEL \"Capacidad/necesidad de financiamiento\" AS PTMO, T.C_Sector_pub AS GRUPO\r",
    "\tFROM PN_SF_SubS as T\r",
    "\tGROUP by T.PERIODO\r",
    "\tORDER by T.PERIODO,T.C_Sector_pub;\r",
    "QUIT;\r",
    "proc sgrender data=PN_SF_SubS2 template=template_chart1;\r",
    "\tdynamic VAR=\"RATIO\" varlabel=\"Ratio\" normal=\"yes\"\r",
    "\t\t\tVAR2=\"PTMO\" varlabel=\"PTMO\" normal=\"yes\"\r",
    "\t\t\tVAR3=\"GRUPO\" varlabel=\"Grupo\" normal=\"yes\"\r",
    "\t\t\ttitle=\"PRÉSTAMO NETO POR SUB-SECTOR\"\r",
    "\t\t\ttitle2=\"(porcentaje del PIB)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "PROC SQL; DROP TABLE PN_SF_SubS2,PN_SF_SubS;QUIT;\r",
    "\r",
    "/*GRAFICO FLUJOS DEL ACTIVO POR COMPONENTES*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE AF_PIB_SF_sUBs AS\r",
    "\t\tSELECT T.PERIODO, SUM(T.RATIO) AS RATIO, T.C_Sector_pub\r",
    "\tFROM CF_PIB_SF_sUBs as T\r",
    "\tWHERE T.C_ENTRADA='D' \r",
    "\tGROUP BY T.PERIODO,T.C_Sector_pub;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "\tCREATE TABLE AF_PIB_SF_sUBs2 AS\r",
    "\t\tSELECT T.PERIODO, T.RATIO FORMAT COMMA20.1, SUM(T.RATIO) FORMAT COMMA20.1 LABEL \"Inversión financiera\" AS INV_F, T.C_Sector_pub AS GRUPO\r",
    "\tFROM AF_PIB_SF_sUBs as T\r",
    "\tGROUP BY T.PERIODO\r",
    "\t\tORDER BY T.PERIODO,T.C_Sector_pub;\r",
    "QUIT;\r",
    "proc sgrender data=AF_PIB_SF_sUBs2 template=template_chart1;\r",
    "\tdynamic VAR=\"RATIO\" varlabel=\"Ratio\" normal=\"yes\"\r",
    "\t\t\tVAR2=\"INV_F\" varlabel=\"INV_F\" normal=\"yes\"\r",
    "\t\t\tVAR3=\"GRUPO\" varlabel=\"Grupo\" normal=\"yes\"\r",
    "\t\t\ttitle=\"FLUJOS DEL ACTIVO POR SUB-SECTOR\"\r",
    "\t\t\ttitle2=\"(porcentaje del PIB)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "PROC SQL; DROP TABLE AF_PIB_SF_sUBs2,AF_PIB_SF_sUBs;QUIT;\r",
    "\r",
    "/*GRAFICO FLUJOS DEL PASIVO POR COMPONENTES*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE P_PIB_SF_SubS AS\r",
    "\t\tSELECT T.PERIODO, SUM(T.RATIO)*-1 AS RATIO, T.C_Sector_pub\r",
    "\tFROM CF_PIB_SF_SubS as T\r",
    "\tWHERE T.C_ENTRADA='H' \r",
    "\tGROUP BY T.PERIODO,T.C_Sector_pub;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "\tCREATE TABLE P_PIB_SF_SubS2 AS\r",
    "\t\tSELECT T.PERIODO, T.RATIO FORMAT COMMA20.1,SUM(T.RATIO) FORMAT COMMA20.1 LABEL \"Financiamiento\" AS PAS, T.C_Sector_pub AS GRUPO\r",
    "\tFROM P_PIB_SF_SubS as T\r",
    "\tGROUP BY T.PERIODO\r",
    "\tORDER BY T.PERIODO,T.C_Sector_pub;\r",
    "QUIT;\r",
    "proc sgrender data=P_PIB_SF_SubS2 template=template_chart1;\r",
    "\tdynamic VAR=\"RATIO\" varlabel=\"Ratio\" normal=\"yes\"\r",
    "\t\t\tVAR2=\"PAS\" varlabel=\"INV_F\" normal=\"yes\"\r",
    "\t\t\tVAR3=\"GRUPO\" varlabel=\"Grupo\" normal=\"yes\"\r",
    "\t\t\ttitle=\"FLUJOS DEL PASIVO POR SUBSECTOR\"\r",
    "\t\t\ttitle2=\"(porcentaje del PIB)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "PROC SQL; DROP TABLE P_PIB_SF_SubS2,P_PIB_SF_SubS;QUIT;\r",
    "\r",
    "/*CREA BASE CON INFO DEUDA  SOBRE PIB*/\r",
    "PROC SQL;\r",
    "CREATE TABLE WORK.D_SF_PIB_SS AS\r",
    "SELECT T1.AÑO,T1.TRIM,T1.PERIODO,t1.C_Sector_pub,t1.N_Sector_pub,T1.C_SCN_N0,T1.N_SCN_N0,T1.SECTOR,\r",
    "     (CASE  WHEN T1.C_SI_PUBL<>6  THEN 'Mercado local' \r",
    "\t\t  ELSE 'Sector externo' END) AS N_SI_C_AGENTE,\r",
    "\t(CASE WHEN T1.C_SCN_N0='AF.4' THEN 'Préstamos'\r",
    "\t\tWHEN T1.C_SCN_N0='AF.3'  THEN 'Bonos'\r",
    "\t\t\telse 'Efectivo y depósitos' end) AS C_SCN_CA,\r",
    "\tSUM((T1.DATO/T2.DATO)*100) FORMAT COMMA14.1 AS DATO\r",
    "FROM WORK.DEUDA_SF_SubS T1, WORK.PIB_ACUM T2 WHERE T1.AÑO=T2.AÑO AND T1.TRIM=T2.TRIM\r",
    "GROUP BY T1.AÑO,T1.TRIM,T1.PERIODO,T1.C_SCN_N0,T1.N_SCN_N0,T1.SECTOR,calculated N_SI_C_AGENTE,calculated C_SCN_CA,t1.C_Sector_pub,t1.N_Sector_pub;\r",
    "QUIT;\r",
    "\r",
    "/*GRAFICO DEUDA POR COMPONENTES*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE D_SF_PIB_SS_2 AS\r",
    "\t\tSELECT T.PERIODO, SUM(T.DATO) AS RATIO, T.C_Sector_pub\r",
    "\tFROM WORK.D_SF_PIB_SS as T\r",
    "\tGROUP BY T.PERIODO,T.C_Sector_pub;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "\tCREATE TABLE D_SF_PIB_SS_F AS\r",
    "\t\tSELECT T.PERIODO, T.RATIO FORMAT COMMA20.1,SUM(T.RATIO) FORMAT COMMA20.1 LABEL \"Deuda\" AS Deuda, T.C_Sector_pub AS GRUPO\r",
    "\tFROM D_SF_PIB_SS_2 as T\r",
    "\tGROUP BY T.PERIODO\r",
    "\tORDER BY T.PERIODO,T.C_Sector_pub;\r",
    "QUIT;\r",
    "proc sgrender data=D_SF_PIB_SS_F template=template_chart1;\r",
    "\tdynamic VAR=\"RATIO\" varlabel=\"Ratio\" normal=\"yes\"\r",
    "\t\t\tVAR2=\"Deuda\" varlabel=\"Deuda\" normal=\"yes\"\r",
    "\t\t\tVAR3=\"GRUPO\" varlabel=\"Grupo\" normal=\"yes\"\r",
    "\t\t\ttitle=\"DEUDA A PIB POR SUB-SECTOR\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "PROC SQL; DROP TABLE D_SF_PIB_SS_F,D_SF_PIB_SS_2;QUIT;\r",
    "/*PROC SQL; DROP TABLE RFN_SF,RFN_PIB_SF;QUIT;\r",
    "\r",
    "*/\r",
    "proc datasets lib=work;\r",

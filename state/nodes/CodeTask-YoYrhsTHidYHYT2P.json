  "code_lines": [
    "﻿/*COMPRIME TABLA PRINCIPAL*/\r",
    "DATA tablas.BD_CTSI (COMPRESS=YES); SET tablas.BD_CTSI; RUN;\r",
    "/*IMPUTA PASIVO DE DERIVADOS EN SECTOR 321 CON CA 6, USANDO INFO DEL ACTIVO DEL RM CON CA 321. AJUSTA IMPUTACIÓN EN PASIVO DE SECTOR 321 CON CA 53*/\r",
    "PROC SQL;\r",
    "CREATE TABLE AF34_6_321 AS \r",
    "SELECT  \t'P' AS MONEDA,\r",
    "\t\t\tt1.'AÑO'n,\r",
    "\t\t\tT1.TRIM,\r",
    "    \t  \tINPUT(T1.C_CAGENTE,BEST.) AS SECTOR,\r",
    "\t\t   \tLEFT(PUT(T1.SECTOR,CHAR11.)) AS C_CAGENTE,\r",
    "\t\t\t(CASE WHEN T1.C_CUENTA='Rec Precio Reaj' THEN 'Rec Precio' ELSE T1.C_CUENTA END) AS C_CUENTA,\r",
    "\t\t\t'H' AS C_ENTRADA,\t\t\t\r",
    "\t\t\tSUM(T1.DATO) AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           \tT1.N_SCN,\r",
    "\t\t   \t'PS' AS FUENTE,\t\r",
    "\t\t   \t'0408' AS PROC\r",
    "FROM \t\tTABLAS.BD_CTSI t1\r",
    "WHERE \t\t(T1.C_ENTRADA='D' AND T1.C_SCN='AF.34' AND C_CAGENTE='321' AND SECTOR=6)  \r",
    "GROUP BY \tCALCULATED MONEDA,t1.'AÑO'n, T1.TRIM,CALCULATED C_CUENTA, t1.C_SCN,t1.N_SCN, CALCULATED SECTOR, CALCULATED C_CAGENTE;\r",
    "QUIT;\r",
    "\r",
    "PROC SQL;\r",
    "CREATE TABLE AF34_321_53 AS \r",
    "SELECT  \tT1.MONEDA,\r",
    "\t\t\tt1.'AÑO'n, \r",
    "\t\t\tT1.TRIM,\r",
    "    \t  \tT1.SECTOR,\r",
    "\t\t   \t'53' AS C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\tT1.C_ENTRADA,\t\t\t\r",
    "\t\t\tT1.DATO*-1 AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           \tT1.N_SCN,\r",
    "\t\t   \tT1.FUENTE,\t\r",
    "\t\t   \tT1.PROC\r",
    "FROM \t\tAF34_6_321 t1;\r",
    "QUIT;\r",
    "\r",
    "PROC DATASETS;\r",
    "APPEND BASE=TABLAS.BD_CTSI DATA=AF34_6_321 FORCE;RUN;\r",
    "PROC DATASETS;\r",
    "APPEND BASE=TABLAS.BD_CTSI DATA=AF34_321_53 FORCE;RUN;\r",
    "\r",
    "PROC SQL; \r",
    "DROP TABLE AF34_6_321,AF34_321_53; QUIT;\r",
    "\r",
    "/*IMPUTA PASIVO DE DERIVADOS EN SECTOR 321 CON CA 31, USANDO INFO DEL ACTIVO DEL 31 CON CA 321. AJUSTA IMPUTACIÓN EN PASIFO DE SECTOR 321 CON CA 53*/\r",
    "PROC SQL;\r",
    "CREATE TABLE AF34_31_321 AS \r",
    "SELECT  \t'P' AS MONEDA,\r",
    "\t\t\tt1.'AÑO'n, \r",
    "\t\t\tT1.TRIM,\r",
    "    \t  \tINPUT(T1.C_CAGENTE,BEST.) AS SECTOR,\r",
    "\t\t   \tLEFT(PUT(T1.SECTOR,CHAR11.)) AS C_CAGENTE,\r",
    "\t\t\t(CASE WHEN T1.C_CUENTA='Rec Precio Reaj' THEN 'Rec Precio' ELSE T1.C_CUENTA END) AS C_CUENTA,\r",
    "\t\t\t'H' AS C_ENTRADA,\t\t\t\r",
    "\t\t\tSUM(T1.DATO) AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           \tT1.N_SCN,\r",
    "\t\t   \t'PS' AS FUENTE,\t\r",
    "\t\t   \t'0409' AS PROC\r",
    "FROM \t\tTABLAS.BD_CTSI t1\r",
    "WHERE \t\t(T1.C_ENTRADA='D' AND T1.C_SCN='AF.34' AND C_CAGENTE='321' AND SECTOR=31)  \r",
    "GROUP BY \tCALCULATED MONEDA,t1.'AÑO'n, T1.TRIM,CALCULATED C_CUENTA, t1.C_SCN,t1.N_SCN, CALCULATED SECTOR, CALCULATED C_CAGENTE;\r",
    "QUIT;\r",
    "\r",
    "PROC SQL;\r",
    "CREATE TABLE AF34_321_53 AS \r",
    "SELECT  \tT1.MONEDA,\r",
    "\t\t\tt1.'AÑO'n, \r",
    "\t\t\tT1.TRIM,\r",
    "    \t  \tT1.SECTOR,\r",
    "\t\t   \t'53' AS C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\tT1.C_ENTRADA,\t\t\t\r",
    "\t\t\tT1.DATO*-1 AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           \tT1.N_SCN,\r",
    "\t\t   \tT1.FUENTE,\t\r",
    "\t\t   \t'0410' AS PROC\r",
    "FROM \t\tAF34_31_321 t1;\r",
    "QUIT;\r",
    "\r",
    "PROC DATASETS;\r",
    "APPEND BASE=TABLAS.BD_CTSI DATA=AF34_31_321 FORCE;RUN;\r",
    "PROC DATASETS;\r",
    "APPEND BASE=TABLAS.BD_CTSI DATA=AF34_321_53 FORCE;RUN;\r",
    "\r",
    "PROC SQL; \r",
    "DROP TABLE AF34_31_321,AF34_321_53; QUIT;\r",
    "\r",
    "/*IMPUTA ACTIVO DE DERIVADOS EN SECTOR 321 CON CA 6, USANDO INFO DEL PASIVO DEL 6 CON CA 321. AJUSTA IMPUTACIÓN EN ACTIVO DE SECTOR 321 CON CA 53*/\r",
    "PROC SQL;\r",
    "CREATE TABLE AF34_321_6 AS \r",
    "SELECT  \t'P' AS MONEDA,\r",
    "\t\t\tt1.'AÑO'n, \r",
    "\t\t\tT1.TRIM,\r",
    "    \t  \tINPUT(T1.C_CAGENTE,BEST.) AS SECTOR,\r",
    "\t\t   \tLEFT(PUT(T1.SECTOR,CHAR11.)) AS C_CAGENTE,\r",
    "\t\t\t(CASE WHEN T1.C_CUENTA='Rec Precio Reaj' THEN 'Rec Precio' ELSE T1.C_CUENTA END) AS C_CUENTA,\r",
    "\t\t\t'D' AS C_ENTRADA,\t\t\t\r",
    "\t\t\tSUM(T1.DATO) AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           \tT1.N_SCN,\r",
    "\t\t   \t'PS' AS FUENTE,\t\r",

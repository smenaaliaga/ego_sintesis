    "FROM \t\tTABLAS.BD_CTSI t1\r",
    "WHERE \t\t(T1.C_ENTRADA='H' AND T1.C_SCN='AF.34' AND C_CAGENTE='321' AND SECTOR=6)  \r",
    "GROUP BY \tCALCULATED MONEDA,t1.'AÑO'n, T1.TRIM,CALCULATED C_CUENTA, t1.C_SCN,t1.N_SCN, CALCULATED SECTOR, CALCULATED C_CAGENTE;\r",
    "QUIT;\r",
    "\r",
    "PROC SQL;\r",
    "CREATE TABLE AF34_321_53D AS \r",
    "SELECT  \tT1.MONEDA,\r",
    "\t\t\tt1.'AÑO'n, \r",
    "\t\t\tT1.TRIM,\r",
    "    \t  \tT1.SECTOR,\r",
    "\t\t   \t'53' AS C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\tT1.C_ENTRADA,\t\t\t\r",
    "\t\t\tT1.DATO*-1 AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           \tT1.N_SCN,\r",
    "\t\t   \tT1.FUENTE,\t\r",
    "\t\t   \t'0412' AS PROC\r",
    "FROM \t\tAF34_321_6 t1;\r",
    "QUIT;\r",
    "\r",
    "PROC DATASETS;\r",
    "APPEND BASE=TABLAS.BD_CTSI DATA=AF34_321_6 FORCE;RUN;\r",
    "PROC DATASETS;\r",
    "APPEND BASE=TABLAS.BD_CTSI DATA=AF34_321_53D FORCE;RUN;\r",
    "\r",
    "PROC SQL; \r",
    "DROP TABLE AF34_321_6,AF34_321_53D; QUIT;\r",
    "\r",
    "/*IMPUTA ACTIVO DE DERIVADOS EN SECTOR 339011 CON CA 6, USANDO INFO DEL PASIVO DEL 6 CON CA 33901/351. AJUSTA IMPUTACIÓN EN ACTIVO DE AF71 DE SECTOR 339011 CON CA 6*/\r",
    "/*AJUSTE CIERRE 2024: INCORPORA AJUSTE EN TÉRMINIS DE DELTA, YA QUE POR DESCUADRE EN af.32 CON RM EN 2024Q4, SE DECIDE GENERAR AF.34 ACTIVO EN FI*/\r",
    "PROC SQL;/*CIERRE 2024*/\r",
    "CREATE TABLE AF34_339011_6 AS \r",
    "SELECT  \t'P' AS MONEDA,\r",
    "\t\t\tt1.'AÑO'n, \r",
    "\t\t\tT1.TRIM,\r",
    "    \t  \t339011 AS SECTOR,\r",
    "\t\t   \t/*LEFT(PUT(T1.SECTOR,CHAR11.))*/ '6' AS C_CAGENTE,\r",
    "\t\t\t(CASE WHEN T1.C_CUENTA='Rec Precio Reaj' THEN 'Rec Precio' ELSE T1.C_CUENTA END) AS C_CUENTA,\r",
    "\t\t\t'D' AS C_ENTRADA,\t\t\t\r",
    "\t\t\t/*SUM(T1.DATO)*/ SUM(CASE WHEN T1.C_ENTRADA='D' THEN T1.DATO*-1 ELSE T1.DATO END) AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           \tT1.N_SCN,\r",
    "\t\t   \t'PS' AS FUENTE,\t\r",
    "\t\t   \t'0413' AS PROC\r",
    "FROM \t\tTABLAS.BD_CTSI t1\r",
    "WHERE \t\t(T1.C_ENTRADA='H' AND T1.C_SCN='AF.34' AND C_CAGENTE='33901/351' AND SECTOR=6)  OR (T1.C_ENTRADA='D' AND T1.C_SCN='AF.34' AND C_CAGENTE='6' AND SECTOR=339011) \r",
    "GROUP BY \tCALCULATED MONEDA,t1.'AÑO'n, T1.TRIM,CALCULATED C_CUENTA, t1.C_SCN,t1.N_SCN, CALCULATED SECTOR, CALCULATED C_CAGENTE;\r",
    "QUIT;\r",
    "\r",
    "PROC SQL;\r",
    "CREATE TABLE AF71_339011_6 AS \r",
    "SELECT  \tT1.MONEDA,\r",
    "\t\t\tt1.'AÑO'n, \r",
    "\t\t\tT1.TRIM,\r",
    "    \t  \tT1.SECTOR,\r",
    "\t\t   \tT1.C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\tT1.C_ENTRADA,\t\t\t\r",
    "\t\t\tT1.DATO*-1 AS DATO,\r",
    "\t\t\t'AF.71' AS C_SCN,\r",
    "           \t'Ajuste conciliación' AS N_SCN,\r",
    "\t\t   \tT1.FUENTE,\t\r",
    "\t\t   \t'0414' AS PROC\r",
    "FROM \t\tAF34_339011_6 t1;\r",
    "QUIT;\r",
    "\r",
    "PROC DATASETS;\r",
    "APPEND BASE=TABLAS.BD_CTSI DATA=AF71_339011_6 FORCE;RUN;\r",
    "PROC DATASETS;\r",
    "APPEND BASE=TABLAS.BD_CTSI DATA=AF34_339011_6 FORCE;RUN;\r",
    "\r",
    "PROC SQL; \r",
    "DROP TABLE AF71_339011_6,AF34_339011_6; quit;\r",
    "\r",
    "/*COMPARA ACTIVO DE FP CON RM CON PASIVO DE RM CON FP. LA DIFERENCIA LA IMPUTA EN ACTIVO DE FP CON RM, Y AJUSTA ACTIVO DE AF34 DE FP CON CA 3*/\r",
    "PROC SQL;\r",
    "CREATE TABLE AF34_34_6 AS \r",
    "SELECT  \t'P' AS MONEDA,\r",
    "\t\t\tt1.'AÑO'n, \r",
    "\t\t\tT1.TRIM,\r",
    "    \t   \t34 AS SECTOR,\r",
    "\t\t   \t'6' AS C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\t'D' AS C_ENTRADA,\t\t\t\r",
    "\t\t\tSUM(CASE WHEN T1.C_ENTRADA='D' THEN T1.DATO*-1 ELSE T1.DATO END) AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           \tT1.N_SCN,\r",
    "\t\t   \t'PS' AS FUENTE,\t\r",
    "\t\t   \t'0418' AS PROC\r",
    "FROM \t\tTABLAS.BD_CTSI t1\r",
    "WHERE \t\t(T1.C_ENTRADA='D' AND T1.C_SCN='AF.34' AND T1.SECTOR IN (34,341) AND T1.C_CAGENTE='6') OR (T1.C_ENTRADA='H' AND T1.C_SCN='AF.34' AND T1.SECTOR=6 AND T1.C_CAGENTE='34')\r",
    "GROUP BY \tCALCULATED MONEDA,t1.'AÑO'n, T1.TRIM,CALCULATED SECTOR, CALCULATED C_CAGENTE,T1.C_CUENTA,CALCULATED C_ENTRADA,t1.C_SCN,t1.N_SCN;\r",
    "QUIT;\r",
    "\r",
    "PROC SQL;\r",
    "CREATE TABLE AF34_34_3 AS \r",
    "SELECT  \tT1.MONEDA,\r",
    "\t\t\tt1.'AÑO'n, \r",
    "\t\t\tT1.TRIM,\r",
    "    \t   \tT1.SECTOR,\r",
    "\t\t   \t'3' AS C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\tT1.C_ENTRADA,\t\t\t\r",
    "\t\t\tT1.DATO*-1 AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           \tT1.N_SCN,\r",
    "\t\t    T1.FUENTE,\t\r",
    "\t\t   \t'0419' AS PROC\r",
    "FROM \t\tAF34_34_6 t1;\r",
    "QUIT;\r",
    "\r",
    "PROC DATASETS;\r",
    "APPEND BASE=TABLAS.BD_CTSI DATA=AF34_34_6 FORCE;RUN;\r",
    "PROC DATASETS;\r",
    "APPEND BASE=TABLAS.BD_CTSI DATA=AF34_34_3 FORCE;RUN;\r",
    "\r",
    "PROC SQL; \r",
    "DROP TABLE AF34_34_6,AF34_34_3; quit;\r",
    "\r",
    "/*CIERRE 2021: COMPARA ACTIVO DE DERIVADOS DE SECTORES OFIS-AUX-PENSIONES CON CONTRAGENTE BANCOS. IMPUTA EN PASIVO DE BANCOS Y AJUSTA EN BANCOS CONTRAGENTE 53 */\r",
    "PROC SQL;\r",
    "CREATE TABLE AF34_SECT_321 AS \r",
    "SELECT  \t'P' AS MONEDA,\r",
    "\t\t\tt1.'AÑO'n, \r",
    "\t\t\tT1.TRIM,\r",
    "    \t  \tINPUT(T1.C_CAGENTE,BEST.) AS SECTOR,\r",
    "\t\t   \tLEFT(PUT(T1.SECTOR,CHAR11.)) AS C_CAGENTE,\r",
    "\t\t\t(CASE WHEN T1.C_CUENTA='Rec Precio Reaj' THEN 'Rec Precio' ELSE T1.C_CUENTA END) AS C_CUENTA,\r",
    "\t\t\t'H' AS C_ENTRADA,\t\t\t\r",
    "\t\t\tSUM(T1.DATO) AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           \tT1.N_SCN,\r",
    "\t\t   \t'PS' AS FUENTE,\t\r",
    "\t\t   \t'0419a' AS PROC\r",
    "FROM \t\tTABLAS.BD_CTSI t1\r",
    "WHERE \t\tT1.C_ENTRADA='D' AND T1.C_SCN='AF.34' AND T1.C_CAGENTE='321' AND SUBSTR(LEFT(PUT(T1.SECTOR,CHAR6.)),1,2) IN ('34','33','36','37') AND T1.SECTOR NOT IN (339011,3390101,3390102,33901,331) \r",
    "GROUP BY \tCALCULATED MONEDA,t1.'AÑO'n, T1.TRIM,CALCULATED C_CUENTA, t1.C_SCN,t1.N_SCN, CALCULATED SECTOR, CALCULATED C_CAGENTE;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "CREATE TABLE AF34_321_53 AS \r",
    "SELECT  \tT1.MONEDA,\r",
    "\t\t\tt1.'AÑO'n, \r",
    "\t\t\tT1.TRIM,\r",
    "    \t  \tT1.SECTOR,\r",
    "\t\t   \t'53' AS C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\tT1.C_ENTRADA,\t\t\t\r",
    "\t\t\tT1.DATO*-1 AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           \tT1.N_SCN,\r",
    "\t\t   \tT1.FUENTE,\t\r",
    "\t\t   \t'0419b' AS PROC\r",
    "FROM \t\tAF34_SECT_321 t1;\r",
    "QUIT;\r",
    "PROC DATASETS;\r",
    "APPEND BASE=TABLAS.BD_CTSI DATA=AF34_SECT_321 FORCE;RUN;\r",
    "PROC DATASETS;\r",
    "APPEND BASE=TABLAS.BD_CTSI DATA=AF34_321_53 FORCE;RUN;\r",
    "PROC SQL; DROP TABLE AF34_SECT_321,AF34_321_53;QUIT;\r",
    "\r",
    "/*CIERRA AJUSTE EN DERIVADOS COMPARANDO ACTIVO CON PASIVO, E IMPUTANDO DIFERENCIA EN ACTIVO DE SECTOR 51022 CON CA 53*/\r",
    "PROC SQL;\r",
    "CREATE TABLE AF34_CIERRE AS \r",
    "SELECT  \t'P' AS MONEDA,\r",
    "\t\t\tt1.'AÑO'n, \r",
    "\t\t\tT1.TRIM,\r",
    "    \t   \t51022 AS SECTOR,\r",
    "\t\t   \t'53' AS C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\t'D' AS C_ENTRADA,\t\t\t\r",
    "\t\t\tSUM(CASE WHEN T1.C_ENTRADA='D' THEN T1.DATO*-1 ELSE T1.DATO END) AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           \tT1.N_SCN,\r",
    "\t\t   \t'PS' AS FUENTE,\t\r",
    "\t\t   \t'0422' AS PROC\r",
    "FROM \t\tTABLAS.BD_CTSI t1\r",
    "WHERE \t\t(T1.C_ENTRADA='D' AND T1.C_SCN='AF.34') OR (T1.C_ENTRADA='H' AND T1.C_SCN='AF.34')\r",
    "GROUP BY \tCALCULATED MONEDA,t1.'AÑO'n, T1.TRIM,CALCULATED SECTOR, CALCULATED C_CAGENTE,T1.C_CUENTA,CALCULATED C_ENTRADA,t1.C_SCN,t1.N_SCN;\r",
    "QUIT;\r",
    "\r",
    "PROC DATASETS;\r",
    "APPEND BASE=TABLAS.BD_CTSI DATA=AF34_CIERRE FORCE;RUN;\r",
    "\r",
    "PROC SQL; DROP TABLE AF34_CIERRE; quit;\r",
    " \r",
    "/*GENERA ACTIVOS NETOS DE DERIVADOS ELIMINANDO EL PASIVO E IMPUTANDO ESE PASIVO NEGATIVO EN EL ACTIVO DE LOS SECTORES*/\r",
    "PROC SQL;\r",
    "CREATE TABLE AF34_ELIMINA AS \r",
    "SELECT  \tT1.MONEDA,\r",
    "\t\t\tt1.'AÑO'n, \r",
    "\t\t\tT1.TRIM,\r",
    "    \t   \tT1.SECTOR,\r",
    "\t\t   \tT1.C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\tT1.C_ENTRADA,\t\t\t\r",
    "\t\t\tSUM(T1.DATO*-1) AS DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           \tT1.N_SCN,\r",
    "\t\t   \t'PS' AS FUENTE,\t\r",
    "\t\t   \t'0651' AS PROC\r",
    "FROM \t\tTABLAS.BD_CTSI t1\r",
    "WHERE \t\t(T1.C_ENTRADA='H' AND T1.C_SCN='AF.34')\r",
    "GROUP BY \tT1.MONEDA,t1.'AÑO'n, T1.TRIM,T1.SECTOR,T1.C_CAGENTE,T1.C_CUENTA,T1.C_ENTRADA,t1.C_SCN,t1.N_SCN, CALCULATED PROC, CALCULATED FUENTE;\r",
    "QUIT;\r",
    "\r",
    "PROC SQL;\r",
    "CREATE TABLE AF34_NETEA AS \r",
    "SELECT  \tT1.MONEDA,\r",
    "\t\t\tt1.'AÑO'n, \r",
    "\t\t\tT1.TRIM,\r",
    "    \t   \tT1.SECTOR,\r",
    "\t\t   \tT1.C_CAGENTE,\r",
    "\t\t\tt1.C_CUENTA,\r",
    "\t\t\t'D' AS C_ENTRADA,\t\t\t\r",
    "\t\t\tT1.DATO,\r",
    "\t\t\tT1.C_SCN,\r",
    "           \tT1.N_SCN,\r",
    "\t\t   \tT1.FUENTE,\t\r",
    "\t\t   \t'0652' AS PROC\r",
    "FROM \t\tAF34_ELIMINA T1;\r",
    "QUIT;\r",
    "\r",

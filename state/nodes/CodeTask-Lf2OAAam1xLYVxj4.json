  "code_lines": [
    "﻿/*SALDOS DE INSTRUMENTOS FINANCIEROS POR SECTOR-INSTRUMENTO-CONTRAGENTE*/\r",
    "PROC SQL;\r",
    "CREATE TABLE Saldos_SI AS\r",
    "SELECT T1.AÑO,T1.TRIM,(substr(PUT(t1.'AÑO'n,CHAR4.),3,2) ||\".\"|| PUT(t1.TRIM,CHAR1.)) AS PERIODO,T1.C_Cuenta,\r",
    "\t\t(case when T2.C_SI_SCN in ('S.123','S.124') then 'S.123+4' else T2.C_SI_SCN end) as C_Sector_pub,\r",
    "\t\tT2.N_SI_SCN as N_Sector_pub,\r",
    "\tT4.C_SCN_N1,T4.N_SCN_N1,\r",
    "\t(CASE WHEN T1.C_SCN='AF.21' THEN T4.N_SCN\r",
    "\t\tWHEN T1.C_SCN IN ('AF.22','AF.29') THEN 'Depósitos y otros depósitos'\r",
    "\t\t\tWHEN T1.C_SCN IN ('AF.31','AF.32','AF.321') THEN 'Títulos' \r",
    "\t\t\t\tWHEN T1.C_SCN IN ('AF.34') THEN 'Derivados' \r",
    "\t\t\t\t \tWHEN T1.C_SCN IN ('AF.521') THEN 'Cuotas MM' \r",
    "\t\t\t\t\t\tWHEN T1.C_SCN IN ('AF.522') THEN 'Cuotas NM' \r",
    "\t\t\t\telse T4.N_SCN_N0 end) as N_SCN_wtw,\r",
    "\tT4.C_SCN_N0,T4.N_SCN_N0,T3.C_SI_SCN AS C_SI_C_AGENTE,\r",
    "\t(case when T3.C_SI_SCN in ('S.123','S.124') then 'OFIs+Auxiliares' else t3.N_SI_SCN end) AS N_SI_C_AGENTE,\r",
    "\tT1.C_ENTRADA,\r",
    "\tSUM(T1.DATO)/1000 FORMAT COMMA14. AS DATO\r",
    "FROM TABLAS.BD_CTSI T1 \r",
    "LEFT JOIN TABLAS.T_Sectorizacion T2 ON (T1.SECTOR=T2.C_SI) \r",
    "LEFT JOIN TABLAS.T_Instrumentos T4 ON (T1.C_SCN=T4.C_SCN) \r",
    "LEFT JOIN TABLAS.T_Contrapartidas T3 ON (T1.C_CAGENTE=T3.C_CAGENTE) \r",
    "where T1.C_Cuenta in ('Bce Final','Financiera')  AND T1.AÑO>=&ANIO AND T1.C_SCN NOT IN ('B.90','B.9')  \r",
    "GROUP BY T1.AÑO,T1.TRIM,T4.C_SCN_N1,T4.N_SCN_N1,T3.C_SI_SCN,calculated N_SI_C_AGENTE,T4.C_SCN_N0,T4.N_SCN_N0,T1.C_ENTRADA,calculated C_Sector_pub,T2.N_SI_SCN, calculated N_SCN_wtw,T1.C_Cuenta;\r",
    "QUIT;\r",
    "proc sql; update Saldos_SI set N_SI_C_AGENTE='Sociedades no financieras' where C_SI_C_AGENTE='S.99';quit;\r",
    "proc sql; update Saldos_SI set N_SI_C_AGENTE='Fondos de mutuos del mercado moneta' where C_SI_C_AGENTE='S.129';quit;\r",
    "\r",
    "/*Chequeo WTW*/\r",
    "proc sql; create table total as \r",
    "\tselect año,trim,C_Sector_pub,C_SCN_N0,C_Cuenta,C_ENTRADA,sum(dato) as dato\r",
    "\tfrom Saldos_SI\r",
    "\twhere (c_entrada='H' AND N_SCN_wtw=\"&C_WTW\" and N_SCN_wtw not in ('Préstamos')) or (c_entrada='D' AND N_SCN_wtw=\"&C_WTW\" and N_SCN_wtw in ('Préstamos'))\r",
    "\tgroup by año,trim,C_Sector_pub,C_SCN_N0,C_Cuenta,C_ENTRADA;\r",
    "quit;\r",
    "\r",
    "proc sql; create table total_2 as \r",
    "\tselect año,trim,/*C_Sector_pub,*/C_SI_C_AGENTE as C_Sector_pub,C_SCN_N0,C_Cuenta,C_ENTRADA,sum(dato)*-1 as dato\r",
    "\tfrom Saldos_SI\r",
    "\twhere (c_entrada='D' AND N_SCN_wtw=\"&C_WTW\" and N_SCN_wtw not in ('Préstamos')) or (c_entrada='H' AND N_SCN_wtw=\"&C_WTW\" and N_SCN_wtw in ('Préstamos'))\r",
    "\tgroup by año,trim,/*C_Sector_pub,*/C_SI_C_AGENTE,C_SCN_N0,C_Cuenta,C_ENTRADA;\r",
    "quit;\r",
    "proc sql; update total_2 set C_Sector_pub='S.123+4' where C_Sector_pub in ('S.123','S.124');quit;\r",
    "proc sql; update total_2 set C_Sector_pub='S.11' where C_Sector_pub in ('S.99');quit;\r",
    "data total; set total total_2;run;\r",
    "\r",
    "proc sql; create table chequeo as \r",
    "\tselect año,trim,C_Sector_pub,C_SCN_N0,C_Cuenta,round(sum(dato)) FORMAT COMMA14. as dato\r",
    "\tfrom total\r",
    "\tgroup by año,trim,C_Sector_pub,C_SCN_N0,C_Cuenta;\r",
    "quit;\r",
    "proc sql; delete from chequeo where abs(dato)=0;quit;\r",
    "proc sqL;drop table total_2,total;quit;\r",
    "\r",
    "/*balances*/\r",
    "TITLE;\r",
    "TITLE1 \"INSTRUMENTO: &C_WTW\";\r",
    "TITLE2 \"BALANCE Y OPERACIÓN FINANCIERA\";\r",
    "FOOTNOTE;\r",
    "PROC TABULATE\r",
    "DATA=Saldos_SI;\r",
    " WHERE (c_entrada='D' AND N_SCN_wtw=\"&C_WTW\" and N_SCN_wtw not in ('Préstamos'));\r",
    "\tVAR DATO;\r",
    "\tCLASS \"AÑO\"n /\tORDER=UNFORMATTED MISSING;\r",
    "\tCLASS TRIM /\tORDER=UNFORMATTED MISSING;\r",
    "\tCLASS C_CUENTA /\tORDER=UNFORMATTED MISSING;\r",
    "\tCLASS c_Sector_pub /\tORDER=UNFORMATTED MISSING;\r",
    "\tCLASS N_SCN_wtw /\tORDER=UNFORMATTED MISSING;\r",
    "\tCLASS N_SI_C_AGENTE /\tORDER=UNFORMATTED MISSING;\r",
    "\tTABLE N_SI_C_AGENTE='Emisor: ',\r",
    "\t\t/* ROW Statement */\r",
    "\t\tAÑO*TRIM,\r",
    "\t\t/* COLUMN Statement */\r",
    "\t\tC_CUENTA=''*(c_Sector_pub={LABEL=\"\"}*DATO={LABEL=\"\"}*F=COMMA14.0* Sum={LABEL=\"\"}*F=COMMA14.0 ALL='Total'*dato=''*SUM=''*F=COMMA14.0*[S=[background=orange]]) ;\r",
    "\t;RUN;RUN; QUIT;\r",
    "TITLE; FOOTNOTE;\r",
    "\r",
    "/*balances */\r",
    "TITLE;\r",
    "TITLE1 \"INSTRUMENTO: &C_WTW\";\r",
    "TITLE2 \"BALANCE Y OPERACIÓN FINANCIERA\";\r",
    "FOOTNOTE;\r",
    "PROC TABULATE\r",
    "DATA=Saldos_SI;\r",
    " WHERE (c_entrada='H' AND N_SCN_wtw=\"&C_WTW\" and N_SCN_wtw in ('Préstamos'));\r",
    "\tVAR DATO;\r",
    "\tCLASS \"AÑO\"n /\tORDER=UNFORMATTED MISSING;\r",
    "\tCLASS TRIM /\tORDER=UNFORMATTED MISSING;\r",
    "\tCLASS C_CUENTA /\tORDER=UNFORMATTED MISSING;\r",
    "\tCLASS c_Sector_pub /\tORDER=UNFORMATTED MISSING;\r",
    "\tCLASS N_SCN_wtw /\tORDER=UNFORMATTED MISSING;\r",
    "\tCLASS N_SI_C_AGENTE /\tORDER=UNFORMATTED MISSING;\r",
    "\tTABLE N_SI_C_AGENTE='Acreedor: ',\r",
    "\t\t/* ROW Statement */\r",
    "\t\tAÑO*TRIM,\r",
    "\t\t/* COLUMN Statement */\r",
    "\t\tC_CUENTA=''*(c_Sector_pub={LABEL=\"\"}*DATO={LABEL=\"\"}*F=COMMA14.0* Sum={LABEL=\"\"}*F=COMMA14.0 ALL='Total'*dato=''*SUM=''*F=COMMA14.0*[S=[background=orange]]) ;\r",
    "\t;RUN;RUN; QUIT;\r",
    "TITLE; FOOTNOTE;\r",
    "/*\r",
    "LIBNAME DCNIDATA META LIBRARY='DCNIDATA' METAOUT=DATA;\r",
    "data DCNIDATA.SALDOS_WTW_SI;set SALDOS_SI;RUN;*/\r",
    "\r",
    ""
  ]

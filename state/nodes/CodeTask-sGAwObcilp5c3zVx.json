    "PROC SQL;\r",
    "\tCREATE TABLE PF_PIB_SF_SubS2 AS\r",
    "\t\tSELECT T.PERIODO, T.RATIO FORMAT COMMA20.1 ,SUM(T.RATIO) FORMAT COMMA20.1 LABEL \"Pasivos\" AS PASIVOS, T.N_SCN_N2 AS GRUPO\r",
    "\tFROM WORK.PF_PIB_SF_SubS as T\r",
    "\tGROUP BY T.PERIODO\r",
    "\tORDER BY T.PERIODO,T.N_SCN_N2;\r",
    "QUIT;\r",

  "code_lines": [
    "﻿\r",
    "/*GRAFICO RIQUEZA FINANCIERA NETA POR Subsector*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE RFN_SF_SubS AS\r",
    "\t\tSELECT T.PERIODO, SUM(T.DATO) AS RATIO, T.N_SCN_N2\r",
    "\tFROM WORK.RFN_PIB_SF_SubS as T WHERE (T.C_Sector_pub=\"&Sector\")\r",
    "\tGROUP BY T.PERIODO, T.N_SCN_N2;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "\tCREATE TABLE RFN_SF_SubS2 AS\r",
    "\t\tSELECT T.PERIODO, T.RATIO FORMAT COMMA20.1,SUM(T.RATIO) FORMAT COMMA20.1 LABEL \"Posición neta\" AS RFN, T.N_SCN_N2 AS GRUPO\r",
    "\tFROM RFN_SF_SubS as T \r",
    "\tGROUP BY T.PERIODO\r",
    "\tORDER BY T.PERIODO, T.N_SCN_N2;\r",
    "QUIT;\r",
    "proc sgrender data=RFN_SF_SubS2 template=template_chart1;\r",
    "\tdynamic VAR=\"RATIO\" varlabel=\"Ratio\" normal=\"yes\"\r",
    "\t\t\tVAR2=\"RFN\" varlabel=\"RFN\" normal=\"yes\"\r",
    "\t\t\tVAR3=\"GRUPO\" varlabel=\"Grupo\" normal=\"yes\"\r",
    "\t\t\ttitle=\"POSICIÓN FINANCIERA NETA SECTOR FINANCIERO\"\r",
    "\t\t\ttitle2=\"Sub-Sector: &Sector\"\r",
    "\t\t\ttitle3=\"(porcentaje del PIB)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "PROC SQL; DROP TABLE RFN_SF_SubS2,RFN_SF_SubS;QUIT;\r",
    "\r",
    "/*GRAFICO ACTIVOS FINANCIEROSS POR COMPONENTES*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE AF_PIB_SF_SubS AS\r",
    "\t\tSELECT T.PERIODO, SUM(T.DATO) AS RATIO, T.N_SCN_N2\r",
    "\tFROM WORK.RFN_PIB_SF_SubS as T \r",
    "\tWHERE T.C_ENTRADA='D' and T.C_Sector_pub=\"&Sector\"\r",
    "\tGROUP BY T.PERIODO,T.N_SCN_N2;\r",
    "QUIT;\r",
    "PROC SQL;\r",
    "\tCREATE TABLE AF_PIB_SF_SubS2 AS\r",
    "\t\tSELECT T.PERIODO, T.RATIO FORMAT COMMA20.1,SUM(T.RATIO) FORMAT COMMA20.1 LABEL \"Activos financieros\" AS AF, T.N_SCN_N2 AS GRUPO\r",
    "\tFROM WORK.AF_PIB_SF_SubS as T \r",
    "\tGROUP BY T.PERIODO\r",
    "\tORDER BY T.PERIODO,T.N_SCN_N2;\r",
    "QUIT;\r",
    "\r",
    "proc sgrender data=AF_PIB_SF_SubS2 template=template_chart1;\r",
    "\tdynamic VAR=\"RATIO\" varlabel=\"Ratio\" normal=\"yes\"\r",
    "\t\t\tVAR2=\"AF\" varlabel=\"AF\" normal=\"yes\"\r",
    "\t\t\tVAR3=\"GRUPO\" varlabel=\"Grupo\" normal=\"yes\"\r",
    "\t\t\ttitle=\"ACTIVOS FINANCIEROS SECTOR FINANCIERO\"\r",
    "\t\t\ttitle2=\"Sub-Sector: &Sector\"\r",
    "\t\t\ttitle3=\"(porcentaje del PIB)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "PROC SQL; DROP TABLE AF_PIB_SF_SubS2,AF_PIB_SF_SubS;quit;\r",
    "\r",
    "/*GRAFICO PASIVOS FINANCIEROSS POR COMPONENTES*/\r",
    "PROC SQL;\r",
    "\tCREATE TABLE PF_PIB_SF_SubS AS\r",
    "\t\tSELECT T.PERIODO, SUM(T.DATO)*-1 AS RATIO, T.N_SCN_N2\r",

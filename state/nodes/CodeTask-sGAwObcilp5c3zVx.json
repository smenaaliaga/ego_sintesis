    "\t\t\ttitle3=\"(porcentaje del PIB)\";\r",
    "\tods graphics ;\r",
    "run;\r",
    "title;\r",
    "PROC SQL; DROP TABLE PTN_PIB_SF_SubS2,PTN_PIB_SF_SubS;QUIT;\r",
